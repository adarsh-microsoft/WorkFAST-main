        "partitions": [
          {
            "name": "DimOpportunityCD",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "entityName": "DimOpportunityCD",
              "expressionSource": "DatabaseQuery",
              "schemaName": "CoSell"
            }
          }
        ],
        "measures": [
          {
            "name": "# Shared Opportunities",
            "description": "Count of distinct partner-shared opportunities (#PartnerGTM deals where the Microsoft referral or partner acceptance sub-status is 'Accepted'). Core co-sell volume KPI.",
            "expression": [
              "CALCULATE (",
              "        SUMX (",
              "            SUMMARIZE (",
              "                'DimOpportunityCD',",
              "                'DimOpportunityCD'[OpportunityNumber],",
              "                \"Value\",1",
              "            ),",
              "            [Value]",
              "        ),KEEPFILTERS('DimPartnerDealCD'[IsDealWith#PartnerGTM] = 1)",
              "        ,FILTER('DimPartnerDealCD','DimPartnerDealCD'[ReferralMicrosoftSubStatusPartnerCenter] = \"Accepted\" ",
              "        || 'DimPartnerDealCD'[PartnerAcceptanceSubStatusPartnerCenter] = \"Accepted\")",
              "    )"
            ],
            "formatString": "0",
            "lineageTag": "2d2a2ce5-459d-4f97-9c0e-9525df19a7f7",
            "changedProperties": [
              {
                "property": "Name"
              }
            ]
          },
          {
            "name": "$ Shared Opportunities",
            "description": "Value of partner-shared opportunities = Billed Opportunity Revenue + Milestone Estimated Annualized Revenue, restricted to #PartnerGTM accepted deals. Core co-sell value KPI.",
            "expression": [
              "",
              "CALCULATE(",
              "    [Billed Opportunity Revenue] + [Milestone Estimated Annualized Revenue],",
              "    KEEPFILTERS ( 'DimPartnerDealCD'[IsDealWith#PartnerGTM] = 1 ),",
              "    KEEPFILTERS (",
              "        FILTER(",
              "            'DimPartnerDealCD',",
              "            'DimPartnerDealCD'[ReferralMicrosoftSubStatusPartnerCenter] = \"Accepted\"",
              "                || 'DimPartnerDealCD'[PartnerAcceptanceSubStatusPartnerCenter] = \"Accepted\"",
              "        )",
              "    )",
              ")",
              ""
            ],
            "lineageTag": "a4fb3ff6-d1f3-49bc-a09d-66182676faf7",
            "changedProperties": [
              {
                "property": "Name"
              }
            ]
          },
          {
            "name": "Billed Opportunity Revenue",
            "description": "Opportunity revenue for single-partner, billed opportunities due in FY23-FY26 (de-duplicated by opportunity/product/division). Component of $ Shared Opportunities.",
            "expression": [
              "CALCULATE (",
              "        SUMX (",
              "            SUMMARIZE (",
              "                'FactPipeline',",
              "                'FactPipeline'[OpportunityKey],",
              "                'FactPipeline'[ProductKey],",
              "                'FactPipeline'[RevSumDivisionKey],",
              "                'FactPipeline'[OpportunityRevenue]",
              "            ),",
              "            [OpportunityRevenue]",
              "        ),",
              "        KEEPFILTERS ( 'FactPipeline'[IsMultiPartner] = \"no\" ),",
              "        KEEPFILTERS ( 'DimOpportunityCD'[IsBilledOpportunity] = \"Yes\" ),",
              "        KEEPFILTERS ( 'DimOpportunityCD'[OpportunityDueFiscalYear] IN {\"FY23\",\"FY24\",\"FY25\",\"FY26\"} )",
              "    )"
            ],
            "lineageTag": "e4380dd7-6550-457e-a6d7-09ecd4ea00bd",
            "changedProperties": [
              {
                "property": "Name"
              }
            ],
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Milestone Estimated Annualized Revenue",
            "description": "Estimated annualized revenue rolled up across engagement milestones (sums the per-milestone base measure).",
            "expression": "SUMX('DimEngagementMilestoneCD',[Milestone Estimated Annualized Revenue Base])",
            "lineageTag": "de177295-0d0b-4166-a40f-17db630a6ccf",
            "changedProperties": [
              {
                "property": "Name"
              }
            ]
          },
          {
            "name": "Milestone Estimated Annualized Revenue Base",
            "description": "Per-milestone estimated annualized revenue. Annualizes recurring milestones over the remaining fiscal months (capped 1-24 months); non-recurring milestones counted once. Uses fiscal-month boundaries varMaxFiscalMonthID / varMaxEstFiscalMonthID (update these as the fiscal window rolls forward).",
            "expression": [
              "",
              "VAR varMaxFiscalMonthID = 432  // FY25-June (This value should be last month of Next fiscal year)",
              "VAR varMaxEstFiscalMonthID = MIN( CALCULATE ( MAX('DimEngagementMilestoneCD'[EstimatedFiscalMonthID])), 433) //FY26 July (This value should be one month ahead of the previous variable)",
              "VAR varIsNonRecurringMilestone = CALCULATE ( MAX( 'DimEngagementMilestoneCD'[IsNonRecurringEngagementMilestone] ) )",
              "RETURN",
              "    IF ( varIsNonRecurringMilestone = \"No\"",
              "        ,CALCULATE( [Milestone Estimated Monthly Revenue] * IF( (varMaxFiscalMonthID - varMaxEstFiscalMonthID + 1) <= 0 || (varMaxFiscalMonthID - varMaxEstFiscalMonthID + 1) > 24",
              "                                                                ,BLANK()",
              "                                                                ,(varMaxFiscalMonthID - varMaxEstFiscalMonthID + 1) ",
              "                                                            )",
              "                       ",
              "            )",
              "        ,IF((varMaxFiscalMonthID - varMaxEstFiscalMonthID + 1) <= 0 || (varMaxFiscalMonthID - varMaxEstFiscalMonthID + 1) > 24, BLANK(), [Milestone Estimated Monthly Revenue])",
              "    )   "
            ],
            "lineageTag": "517b8d09-02e7-4236-8efe-7f26bbdefd97",
            "changedProperties": [
              {
                "property": "Name"
              }
            ]
          },
          {
            "name": "Milestone Estimated Monthly Revenue",
            "description": "Estimated monthly milestone usage/revenue for single-partner milestones (IsMultiPartner='no'), de-duplicated per EngagementMilestoneKey.",
            "expression": [
              "CALCULATE (",
              "        SUMX (",
              "            SUMMARIZE (",
              "                'FactEngagementMilestoneCD',",
              "                'FactEngagementMilestoneCD'[EngagementMilestoneKey],",
              "                'FactEngagementMilestoneCD'[EstimatedMonthlyUsage]",
              "            ),",
              "            [EstimatedMonthlyUsage]",
              "        ),",
              "        KEEPFILTERS ( 'FactEngagementMilestoneCD'[IsMultiPartner] = \"no\" )",
              "    )"
            ],
            "lineageTag": "69c81827-fcc0-4a0c-b7f3-0f9026fa05d9",
            "changedProperties": [
              {
                "property": "Name"
              }
            ],
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "# Pipeline Wins",
            "description": "Count of distinct shared opportunities that were won (BilledRevenueStatus='Won', or ConsumptionStatus='Closed' & reason 'Completed') and partner-accepted/won. Volume of co-sell wins.",
            "expression": [
              "CALCULATE (",
              "        SUMX (",
              "            SUMMARIZE (",
              "                'DimOpportunityCD',",
              "                'DimOpportunityCD'[OpportunityNumber],",
              "                \"Value\",1",
              "            ),",
              "            [Value]",
              "        )",
              "        ,KEEPFILTERS('DimPartnerDealCD'[IsDealWith#PartnerGTM] = 1)",
              "        ,FILTER('DimPartnerDealCD','DimPartnerDealCD'[ReferralMicrosoftSubStatusPartnerCenter] = \"Accepted\" ",
              "            || 'DimPartnerDealCD'[PartnerAcceptanceSubStatusPartnerCenter] = \"Accepted\" || 'DimPartnerDealCD'[PartnerAcceptanceSubStatusPartnerCenter] = \"Won\")",
              "        ,FILTER('DimOpportunityCD','DimOpportunityCD'[BilledRevenueStatus] = \"Won\" ",
              "            || ('DimOpportunityCD'[ConsumptionStatus] = \"Closed\" && 'DimOpportunityCD'[ConsumptionStatusReason] = \"Completed\")",
              "    ))"
            ],
            "formatString": "0",
            "lineageTag": "a2416928-885a-4e7b-ab89-58849cb229b5",
            "changedProperties": [
              {
                "property": "Name"
              }
            ]
          },
          {
            "name": "$ Pipeline Wins",
            "description": "Value of won shared opportunities (realized co-sell revenue). Numerator of ROI.",
            "expression": [
              "",
              "CALCULATE([$ Shared Opportunities dup],",
              "            // REMOVEFILTERS('Partner Deal'[Referral SubType]),",
              "          FILTER('DimOpportunityCD','DimOpportunityCD'[BilledRevenueStatus] = \"Won\" ",
              "             || ('DimOpportunityCD'[ConsumptionStatus] = \"Closed\" && 'DimOpportunityCD'[ConsumptionStatusReason] = \"Completed\")",
              "    )",
              ")"
            ],
            "lineageTag": "109c4944-c575-40be-9b81-1051bc6394c1",
            "changedProperties": [
              {
                "property": "Name"
              }
            ]
          },
          {
            "name": "$ Shared Opportunities dup",
            "description": "Helper variant of $ Shared Opportunities that removes the Referral SubType filter for 'Partner Led - PC' to avoid under-counting; consumed by $ Pipeline Wins.",
            "expression": [
              "",
              "VAR Base = [$ Shared Opportunities]",
              "VAR SubType = SELECTEDVALUE('DimPartnerDealCD'[ReferralSubType])",
              "RETURN",
              "IF(",
              "    HASONEVALUE('DimPartnerDealCD'[ReferralSubType])",
              "        && SubType = \"Partner Led - PC\",",
              "    CALCULATE(",
              "        Base,",
              "        REMOVEFILTERS('DimPartnerDealCD'[ReferralSubType])",
              "    ),",
              "    Base",
              ")",
              ""
            ],
            "lineageTag": "1344f4fb-a9fd-4fd0-9d0b-1becde4a9b39",
            "changedProperties": [
              {
                "property": "Name"
              }
            ],
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "ROI",
            "description": "Return on investment for co-marketing = $ Pipeline Wins / Investment Approved Amount.",
            "expression": "DIVIDE([$ Pipeline Wins], [Investment Approved Amount])",
            "lineageTag": "13e489e5-eeac-474d-9170-17dedbe8a0ba",
            "changedProperties": [
              {
                "property": "Name"
              }
            ],
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
