        "partitions": [
          {
            "name": "FactInvestments",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "entityName": "FactInvestments",
              "expressionSource": "DatabaseQuery",
              "schemaName": "CoMarketing_NewApproach"
            }
          }
        ],
        "measures": [
          {
            "name": "Investment Approved Amount",
            "description": "Total approved co-marketing funding across Investment Asks (de-duplicated per InvestmentAskID). Removes time and #PartnerGTM filters; denominator of ROI.",
            "expression": [
              "CALCULATE (",
              "        SUMX (",
              "            SUMMARIZE (",
              "                'FactInvestments',",
              "                'FactInvestments'[InvestmentAskID],",
              "                'FactInvestments'[ApprovedAmount]",
              "            ),",
              "            [ApprovedAmount]",
              "        ),ALL('DimTimeCD'), ALL('DimPartnerDealCD'[IsDealWith#PartnerGTM])",
              "    )"
            ],
            "formatString": "0",
            "lineageTag": "044d5c96-0e05-4cf6-bd83-fe9b916773dd",
            "changedProperties": [
              {
                "property": "Name"
              }
            ]
          },
          {
            "name": "Investment Requested Amount",
            "description": "Total requested co-marketing funding across Investment Asks (de-duplicated per InvestmentAskID), ignoring the #PartnerGTM deal filter.",
            "expression": [
              "CALCULATE (",
              "        SUMX (",
              "            SUMMARIZE (",
              "                'FactInvestments',",
              "                'FactInvestments'[InvestmentAskID],",
              "                'FactInvestments'[RequestedAmount]",
              "            ),",
              "            [RequestedAmount]",
              "        ), ALL('DimPartnerDealCD'[IsDealWith#PartnerGTM])",
              "    )"
            ],
            "formatString": "0",
            "lineageTag": "ba8310f9-9218-4d5a-b740-b882263be6b5",
            "changedProperties": [
              {
                "property": "Name"
              }
            ]
          },
          {
            "name": "# Shared Referrals",
            "description": "Forecasted shared co-sell referrals (partner-submitted SQLs/leads from joint marketing), de-duplicated per InvestmentAskID. Removes time and #PartnerGTM filters.",
            "expression": [
              "CALCULATE (",
              "        SUMX (",
              "            SUMMARIZE (",
              "                'FactInvestments',",
              "                'FactInvestments'[InvestmentAskID],",
              "                'FactInvestments'[ForecastedSQLs]",
              "            ),",
              "            [ForecastedSQLs]",
              "        )",
              "        ,ALL('DimTimeCD'), ALL('DimPartnerDealCD'[IsDealWith#PartnerGTM])",
              "    )"
            ],
            "lineageTag": "8f261615-f7ef-4491-b4a6-0ab15f6cafb2",
            "changedProperties": [
              {
                "property": "Name"
              }
            ],
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "$ Shared Referrals",
            "description": "Forecasted shared-referral revenue from partner co-marketing investments, de-duplicated per InvestmentAskID. Removes time and #PartnerGTM filters.",
            "expression": [
              "CALCULATE (",
              "        SUMX (",
              "            SUMMARIZE (",
              "                'FactInvestments',",
              "                'FactInvestments'[InvestmentAskID],",
              "                'FactInvestments'[ForecastedRevenue]",
              "            ),",
              "            [ForecastedRevenue]",
              "        ),ALL('DimTimeCD'), ALL('DimPartnerDealCD'[IsDealWith#PartnerGTM])",
              "    )"
            ],
            "lineageTag": "30160506-aa24-477c-950f-90095e49920b",
            "changedProperties": [
              {
                "property": "Name"
              }
            ],
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
