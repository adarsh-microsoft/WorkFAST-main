		summarizeBy: none
		sourceColumn: GPSCRMSolutionID

		annotation SummarizationSetBy = Automatic

	column 'Is Transactable In MarketPlace'
		dataType: string
		sourceProviderType: varchar(8000)
		lineageTag: 8a8dea6a-71ac-4038-b913-846395147995
		sourceLineageTag: IsTransactableInMarketPlace
		summarizeBy: none
		sourceColumn: IsTransactableInMarketPlace

		annotation SummarizationSetBy = Automatic

	column 'Incentive Name'
		dataType: string
		sourceProviderType: varchar(8000)
		lineageTag: 0a6e3d6c-1a03-40ae-b73f-25e236060b8c
		sourceLineageTag: IncentiveName
		summarizeBy: none
		sourceColumn: IncentiveName

		annotation SummarizationSetBy = Automatic

	column 'Is Incentive Eligible'
		dataType: string
		sourceProviderType: varchar(8000)
		lineageTag: fc123282-0f3d-4fff-b36e-4d3b2122ba82
