table 'Fact Partner Deal'
	lineageTag: 497c1413-98f3-4466-b57c-ec63971eb57a
	sourceLineageTag: [CoSell].[FactPartnerDealCD]

	measure 'Funnel Common Measure' =
			
			SWITCH(
			    TRUE(),
			    SELECTEDVALUE('Funnel Category'[Chart Category]) = "# Shared Referrals", [# Partner Deals],
			    SELECTEDVALUE('Funnel Category'[Chart Category]) = "# Pipeline Wins", [# Pipeline Wins],
			    SELECTEDVALUE('Funnel Category'[Chart Category]) = "# Shared Opportunities", [# Shared Opportunities]
			)
			// IF(
			//     SELECTEDVALUE('Partner Deal'[Referral SubType]) = "Partner Led - PC",
			//     CALCULATE(
			//         SWITCH(
			//             TRUE(),
			//             SELECTEDVALUE('Funnel Category'[Chart Category]) = "# Shared Referrals", [# Partner Deals],
			//             SELECTEDVALUE('Funnel Category'[Chart Category]) = "# Pipeline Wins", [# Pipeline Wins],
			//             SELECTEDVALUE('Funnel Category'[Chart Category]) = "# Shared Opportunities", [# Shared Opportunities],
			//             BLANK()
			//         ),
			//         REMOVEFILTERS('Partner Deal'[Referral SubType])
			//     ),
			//     SWITCH(
			//         TRUE(),
			//         SELECTEDVALUE('Funnel Category'[Chart Category]) = "# Shared Referrals", [# Partner Deals],
			//         SELECTEDVALUE('Funnel Category'[Chart Category]) = "# Pipeline Wins", [# Pipeline Wins],
			//         SELECTEDVALUE('Funnel Category'[Chart Category]) = "# Shared Opportunities", [# Shared Opportunities]
			//     )
			// )
		formatString: #,0
		lineageTag: bfe8f11e-b32c-44e2-b115-0b604416752c

		changedProperty = IsHidden

		changedProperty = FormatString

	measure 'Funnel Common Measure Partner Reporting' =
			
			SWITCH(
			    TRUE(),
			    SELECTEDVALUE('Funnel Category 2'[Chart Category]) = "# Shared Referrals", [# Partner Deals],
			    SELECTEDVALUE('Funnel Category 2'[Chart Category]) = "Partner Reported # Wins", [Partner Reported # Wins],
			    SELECTEDVALUE('Funnel Category 2'[Chart Category]) = "# Shared Opportunities", [# Shared Opportunities]
			)
		formatString: 0
		lineageTag: 6cefbb51-859e-49b5-aa77-a87e67f02135

		changedProperty = IsHidden

