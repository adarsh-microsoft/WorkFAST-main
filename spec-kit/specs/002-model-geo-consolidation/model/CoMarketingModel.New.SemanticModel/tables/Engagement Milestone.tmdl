table 'Engagement Milestone'
	lineageTag: fac693c8-7950-4dd3-8e5b-66e16ae1362e
	sourceLineageTag: [CoSell].[DimEngagementMilestoneCD]

	measure 'Milestone Estimated Annualized Revenue Base' = ```
			
			VAR varMaxFiscalMonthID = 432  // FY25-June (This value should be last month of Next fiscal year)
			VAR varMaxEstFiscalMonthID = MIN( CALCULATE ( MAX('Engagement Milestone'[Estimated Fiscal Month ID])), 433) //FY26 July (This value should be one month ahead of the previous variable)
			VAR varIsNonRecurringMilestone = CALCULATE ( MAX( 'Engagement Milestone'[Is Non Recurring Engagement Milestone] ) )
			RETURN
			    IF ( varIsNonRecurringMilestone = "No"
			        ,CALCULATE( [Milestone Estimated Monthly Revenue] * IF( (varMaxFiscalMonthID - varMaxEstFiscalMonthID + 1) <= 0 || (varMaxFiscalMonthID - varMaxEstFiscalMonthID + 1) > 24
			                                                                ,BLANK()
			                                                                ,(varMaxFiscalMonthID - varMaxEstFiscalMonthID + 1) 
			                                                            )
			                       
			            )
			        ,IF((varMaxFiscalMonthID - varMaxEstFiscalMonthID + 1) <= 0 || (varMaxFiscalMonthID - varMaxEstFiscalMonthID + 1) > 24, BLANK(), [Milestone Estimated Monthly Revenue])
			    )   
			```
		isHidden
		lineageTag: f3ef23e2-15dd-40c5-a7c8-9ac6e12ce78b

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Milestone Estimated Annualized Revenue' = ```
			SUMX('Engagement Milestone',[Milestone Estimated Annualized Revenue Base])
			
			
			```
		lineageTag: f755b124-7f7d-4fdf-b391-6bf357545fea

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Milestone Estimated Monthly Revenue' =
			CALCULATE (
			        SUMX (
			            SUMMARIZE (
			                'Fact Engagement Milestone',
			                'Engagement Milestone'[EngagementMilestoneKey],
			                'Fact Engagement Milestone'[EstimatedMonthlyUsage]
			            ),
			            [EstimatedMonthlyUsage]
			        ),
			        KEEPFILTERS ( 'Fact Engagement Milestone'[IsMultiPartner] = "no" )
			    )
		isHidden
		lineageTag: 7ea6ad60-92ec-444d-83dc-418ef38c12e4

		changedProperty = IsHidden

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isGeneralNumber":true}

