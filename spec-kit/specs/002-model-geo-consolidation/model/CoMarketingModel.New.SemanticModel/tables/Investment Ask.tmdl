table 'Investment Ask'
	lineageTag: aea869f4-f1bc-4f3a-8acc-24254f1a91c3
	sourceLineageTag: [CoSell].[InvestmentAsk]

	measure 'Investment Approved Amount' =
			CALCULATE (
			        SUMX (
			            SUMMARIZE (
			                'Investment Ask',
			                'Investment Ask'[InvestmentAskID],
			                'Investment Ask'[ApprovedAmount]
			            ),
			            [ApprovedAmount]
			        ),ALL('Time'), ALL('Partner Deal'[IsDealWith#PartnerGTM])
			    )
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: c4475f67-86ee-4404-a687-8b77d9687f4a

		changedProperty = FormatString

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure '# Partner Investment' =
			CALCULATE(
			    DISTINCTCOUNT('Investment Ask'[PartnerOneId]),
			    ALL('Partner Deal'[IsDealWith#PartnerGTM])
			)
		formatString: 0
		lineageTag: 2fd43468-3da3-4bd4-a0a4-ff8afd630de2

		changedProperty = IsHidden

	measure 'Partner Co-Investment Approved Amount' =
			CALCULATE (
			        SUMX (
			            SUMMARIZE (
			                'Investment Ask',
			                'Investment Ask'[InvestmentAskID],
			                'Investment Ask'[Coinvestmentfrompartners]
			            ),
			            [Coinvestmentfrompartners]
			        ),ALL('Time'),'Investment Ask'[Stage] = "Approved", ALL('Partner Deal'[IsDealWith#PartnerGTM])
			    )
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: bb1f5285-a9e7-4a9c-991c-dc72d4c57fea

	measure '# Estimated Opportunities' = CALCULATE(SUM('Investment Ask'[ForecastedSQLs]), 'Investment Ask'[Stage] = "Approved", ALL('Partner Deal'[IsDealWith#PartnerGTM]))
		formatString: #,0
		lineageTag: daa338f1-e1b3-4902-b33b-d63b1e5a89c0

