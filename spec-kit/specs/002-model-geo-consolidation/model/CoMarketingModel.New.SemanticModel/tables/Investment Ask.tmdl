	measure InvestmentAsk_Areas = ```
			
			VAR CurrentInvestmentAskID = SELECTEDVALUE('Investment Ask'[InvestmentAskID])
			RETURN
			IF(
			    NOT ISBLANK(CurrentInvestmentAskID),
			    CONCATENATEX(
			        DISTINCT(
			            SELECTCOLUMNS(
			                FILTER(
			                    RELATEDTABLE('CustomPartnerReportingGeography'),
			                    'CustomPartnerReportingGeography'[Subsidiary] IN 
			                    VALUES('Inv Bridge Area'[Subsidiary])
			                ),
			                "Area", 'CustomPartnerReportingGeography'[Area]
			            )
			        ),
			        [Area],
			        ", ",
			        [Area], ASC
			    ),
			    BLANK()
			)
			```
		lineageTag: a90f7630-0baa-4fd1-860e-25d90e4f6c7b

		changedProperty = Name

	measure 'Partner Co-Investment' = CALCULATE(sum('Investment Ask'[Coinvestmentfrompartners]), 'Investment Ask'[Stage] = "Approved")
		lineageTag: b6d2d288-b09d-4388-b76b-8b7b3cbd7022

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '$ Approved (Global Investments)' =
			CALCULATE (
			    SUMX (
			        SUMMARIZE (
			            'Investment Ask',
			            'Investment Ask'[InvestmentAskID],
			            'Investment Ask'[ApprovedAmount]
			        ),
			        [ApprovedAmount]
			    ),
			    ALL('Time'),
			    ALL('Partner Deal'[IsDealWith#PartnerGTM]),
			    'Investment Ask'[InvestmentSource] = "WW GTM Investments"
			)
		lineageTag: af6e4f0c-57ac-4910-ab21-7da4533c2cdb

	measure 'Global Investment %' = DIVIDE ( [$ Approved (Global Investments)], [Investment Approved Amount] )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 7a44b5d4-0619-44db-a4b0-a19ba774140c

		changedProperty = FormatString

