	measure 'Focused Areas' = ```
			
			CONCATENATEX(
			    DISTINCT(
			        SELECTCOLUMNS(
			            FILTER(
			                'CustomPartnerReportingGeography',
			                'CustomPartnerReportingGeography'[Subsidiary] IN
			                SELECTCOLUMNS('Inv Bridge Area', "Subsidiary", 'Inv Bridge Area'[Subsidiary])
			            ),
			            "Area", 'CustomPartnerReportingGeography'[Area]
			        )
			    ),
			    [Area],
			    ", ",
			    [Area],
			    ASC
			)
			
			```
		lineageTag: 9367a97f-2efd-4f10-b844-165fff5edc2f

