	measure '# Estimated Opportunities Trailing18Months' =
			
			CALCULATE(
			    SUM('Investment Ask'[ForecastedSQLs]),
			    'Investment Ask'[Stage] = "Approved",
			    DATESINPERIOD(
			        'Investment Ask'[EstimatedCampaignStartDate],
			        TODAY(),
			        -18,
			        MONTH
			    )
			)
		formatString: #,0
		lineageTag: af949fba-f3ce-46d1-b56d-e6ee553a345a

