table IOPO
	lineageTag: 1d65e53f-e0fb-4243-822e-65e81dd5703b
	sourceLineageTag: [CoSell].[DimIOPO]

	measure 'Total Spend' = ```
			
			CALCULATE(
			    SUMX(
			        SUMMARIZE('Fact IOPO'
			                 ,'Fact IOPO'[IOPOKey]
			                 ,'Fact IOPO'[DateTimeKey]
			                 ,'Fact IOPO'[Actual]
			        ),[Actual] 
			    ),
			    ALL('Time')
			)
			```
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 22a3ef02-2e33-43ba-a3de-2bbfeeabd8c3

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Open PO' = ```
			
			CALCULATE(
			    SUMX(
			        SUMMARIZE('Fact IOPO'
			                 ,'Fact IOPO'[IOPOKey]
			                 ,'Fact IOPO'[DateTimeKey]
			                 ,'Fact IOPO'[PO Vendor Name]
			                 ,'Fact IOPO'[PO Line Item & Description]
			                 ,'Fact IOPO'[OpenAmount]
			        ),[OpenAmount] 
			    )
			)
			```
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: dc8a6318-da50-4ea5-a89a-5f4eeab4ce02

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

