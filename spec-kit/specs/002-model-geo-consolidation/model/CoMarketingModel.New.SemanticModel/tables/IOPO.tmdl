	measure 'Committed Amount' = CALCULATE([Open PO] + [Spend],ALL('Time'))
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 3f966db4-d4cc-44f0-8b33-30ffa83b716e

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure JE/Accrual =
			
			CALCULATE(
			    [Spend],
			    FILTER('IOPO', 'IOPO'[PO Number] = "0")
			)
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: d776dca0-db71-4e10-887e-6f09e661a488

		changedProperty = FormatString

	measure Committed = [Open PO] + [Spend]
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: efb78a8b-1c69-4e93-a0d6-e2a5e6e3e8c7

		changedProperty = FormatString

	measure Spend = ```
			CALCULATE(
			    SUMX(
			        SUMMARIZE('Fact IOPO'
			                 ,'Fact IOPO'[IOPOKey]
			                 ,'Fact IOPO'[DateTimeKey]
			                 ,'Fact IOPO'[Actual]
			        ),[Actual] 
			    )
			)
			```
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 47eb9937-7185-4275-9c07-91571d2e3b23

		changedProperty = FormatString

	measure 'Total Spend Trailing18Months' =
			
			CALCULATE(
			    SUMX(
			        SUMMARIZE(
			            'Fact IOPO',
			            'Fact IOPO'[IOPOKey],
			            'Fact IOPO'[DateTimeKey],
			            'Fact IOPO'[Actual]
			        ),
			        [Actual]
			    )
			    ,
			    DATESINPERIOD(
			        'Time'[Date],
			        TODAY(),
			        -18,
			        MONTH
			    )
			)
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: e914e8a2-4621-4d3d-b282-5580b97df499

