			                'Opportunity'[Opportunity Number],
			                "Value",1
			            ),
			            [Value]
			        )
			        ,KEEPFILTERS('Partner Deal'[IsDealWith#PartnerGTM] = 1)
			        ,FILTER('Partner Deal','Partner Deal'[Referral Microsoft SubStatus(PartnerCenter)] = "Accepted" 
			            || 'Partner Deal'[Partner Acceptance SubStatus(PartnerCenter)] = "Accepted" || 'Partner Deal'[Partner Acceptance SubStatus(PartnerCenter)] = "Won")
			        ,FILTER('Opportunity','Opportunity'[Billed Revenue Status] = "Won" 
