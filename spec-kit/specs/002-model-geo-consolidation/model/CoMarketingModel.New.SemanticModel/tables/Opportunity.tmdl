	measure '# Shared Opportunities dup' = ```
			
			VAR IsPartnerLedPC = SELECTEDVALUE('Partner Deal'[Referral SubType]) = "Partner Led - PC"
			 
			VAR TotalWithAllSubTypes =
			    CALCULATE(CALCULATE (
			        SUMX (
			            SUMMARIZE (
			                'Opportunity',
			                'Opportunity'[Opportunity Number],
			                "Value", 1
			            ),
			            [Value]
			        ),
			        KEEPFILTERS('Partner Deal'[IsDealWith#PartnerGTM] = 1),
			        FILTER (
			            'Partner Deal',
			            'Partner Deal'[Referral Microsoft SubStatus(PartnerCenter)] = "Accepted" ||
			            'Partner Deal'[Partner Acceptance SubStatus(PartnerCenter)] = "Accepted"
			        )
			         -- Remove slicer filter only on Referral SubType
			    ),REMOVEFILTERS('Partner Deal'[Referral SubType]))
			 
			VAR TotalWithCurrentSelection =
			    CALCULATE (
			        SUMX (
			            SUMMARIZE (
			                'Opportunity',
			                'Opportunity'[Opportunity Number],
			                "Value", 1
			            ),
			            [Value]
			        ),
			        KEEPFILTERS('Partner Deal'[IsDealWith#PartnerGTM] = 1),
			        FILTER (
			            'Partner Deal',
			            'Partner Deal'[Referral Microsoft SubStatus(PartnerCenter)] = "Accepted" ||
			            'Partner Deal'[Partner Acceptance SubStatus(PartnerCenter)] = "Accepted"
			        )
			    )
			 
			RETURN
			    IF (IsPartnerLedPC, TotalWithAllSubTypes, TotalWithCurrentSelection)
			```
		formatString: #,0
		lineageTag: c07f893b-9ec1-49ff-b08a-dbca80eea2e7

		changedProperty = IsHidden

	measure '$ Shared Opportunities dup' = ```
			
			VAR Base = [$ Shared Opportunities]
			VAR SubType = SELECTEDVALUE('Partner Deal'[Referral SubType])
			RETURN
			IF(
			    HASONEVALUE('Partner Deal'[Referral SubType])
			        && SubType = "Partner Led - PC",
			    CALCULATE(
			        Base,
			        REMOVEFILTERS('Partner Deal'[Referral SubType])
			    ),
			    Base
			)
			
			```
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: ace7bafa-c687-41b4-a1fb-2ba8c000691a

		changedProperty = IsHidden

