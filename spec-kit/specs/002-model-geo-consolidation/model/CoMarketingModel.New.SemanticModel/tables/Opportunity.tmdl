	measure 'Inbound Oppty Wins' =
			
			CALCULATE (
			    [# Oppty],
			    KEEPFILTERS('Partner Deal'[Partner Deal Direction] = "Inbound"),
			    KEEPFILTERS(
			        ('Opportunity'[Consumption Status Reason] = "Completed" &&
			        'Opportunity'[Consumption Status] = "Closed") ||
			        'Opportunity'[Billed Revenue Status] = "Won"
			    )
			)
