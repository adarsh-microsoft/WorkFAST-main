	measure 'Billed Opportunity Revenue' =
			CALCULATE (
			        SUMX (
			            SUMMARIZE (
			                'Fact Opportunity',
			                'Fact Opportunity'[OpportunityKey],
			                'Fact Opportunity'[ProductKey],
			                'Fact Opportunity'[RevSumDivisionKey],
			                'Fact Opportunity'[OpportunityRevenue]
			            ),
			            [OpportunityRevenue]
			        ),
			        KEEPFILTERS ( 'Fact Opportunity'[IsMultiPartner] = "no" ),
			        KEEPFILTERS ( 'Opportunity'[Is Billed Opportunity] = "Yes" ),
			        KEEPFILTERS ( 'Opportunity'[Opportunity Due Fiscal Year] IN {"FY23","FY24","FY25","FY26"} )
			    )
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 6be6529e-6d56-4656-b2cc-06c9b7684b9e

		changedProperty = FormatString

		changedProperty = IsHidden

