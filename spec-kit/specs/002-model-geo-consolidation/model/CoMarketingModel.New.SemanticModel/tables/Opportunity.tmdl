	measure 'Co-sell Opportunities win # (PartnerGTM)' =
			CALCULATE (
			    SUMX (
			        SUMMARIZE (
			            'Opportunity',
			            'Opportunity'[Opportunity Number],
			            "Value", 1
			        ),
			        [Value]
			    ),
			    KEEPFILTERS ( 'Partner Deal'[IsDealWith#PartnerGTM] = 1 ),
			    KEEPFILTERS ( 'Partner Deal'[Partner Deal Direction] = "Inbound" ),
			    KEEPFILTERS ( 'Partner Deal'[Referral SubType] = "Active Co-sell - PC" ),
			    FILTER (
			        'Partner Deal',
			        'Partner Deal'[Referral Microsoft SubStatus(PartnerCenter)] = "Accepted"
			            || 'Partner Deal'[Partner Acceptance SubStatus(PartnerCenter)] = "Accepted"
			            || 'Partner Deal'[Partner Acceptance SubStatus(PartnerCenter)] = "Won"
			    ),
			    FILTER (
			        'Opportunity',
			        'Opportunity'[Billed Revenue Status] = "Won"
			            || (
			                'Opportunity'[Consumption Status] = "Closed"
			                && 'Opportunity'[Consumption Status Reason] = "Completed"
			            )
			    )
