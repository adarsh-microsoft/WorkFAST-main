/// Conformed subsidiary spine introduced by Spec 002.
/// Replaces the bidi-reliant chain DimAccountGeographyHierarchyReporting <-> BridgeGeography
/// <-> CustomPartnerReportingGeography (and the Inv* twin) by becoming the single
/// One-side dim that every geo-bearing fact and dim snowflakes into.
table DimSubsidiary
	lineageTag: e2c11000-0001-4000-9000-000000000001

	column SubsidiaryId
		dataType: string
		isKey
		summarizeBy: none
		sourceColumn: [SubsidiaryId]

		annotation SummarizationSetBy = Automatic

	column SubsidiaryName
		dataType: string
		summarizeBy: none
		sourceColumn: [SubsidiaryName]

		annotation SummarizationSetBy = Automatic

	column FieldSubsidiary
		dataType: string
		summarizeBy: none
		sourceColumn: [FieldSubsidiary]

		annotation SummarizationSetBy = Automatic

	partition DimSubsidiary = calculated
		mode: import
		source =
				ADDCOLUMNS(
					DISTINCT(
						SELECTCOLUMNS(
							'DimAccountGeographyHierarchyReporting',
							"SubsidiaryId", 'DimAccountGeographyHierarchyReporting'[SubsidiaryId],
							"SubsidiaryName", 'DimAccountGeographyHierarchyReporting'[SubsidiaryName]
						)
					),
					"FieldSubsidiary", [SubsidiaryName]
				)

	annotation PBI_ResultType = Table

