        "partitions": [
          {
            "name": "Partner Deal",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "entityName": "DimPartnerDealCD",
              "expressionSource": "DatabaseQuery",
              "schemaName": "CoSell"
            }
          }
        ],
        "measures": [
          {
            "name": "# Partner Deals",
            "expression": "CALCULATE (\n        SUMX (\n            SUMMARIZE (\n                'Partner Deal',\n                'Partner Deal'[PartnerDealKey],\n                \"Value\",1\n            ),\n            [Value]\n        ),\n        REMOVEFILTERS('Partner Deal'[IsDealWith#PartnerGTM])\n    )",
            "formatString": "#,0",
            "lineageTag": "9adac328-a1b2-4feb-b25d-c357180cbb72",
            "changedProperties": [
              {
                "property": "FormatString"
              },
              {
                "property": "IsHidden"
              }
            ]
          },
          {
            "name": "Partners using #PartnerGTM",
            "expression": "CALCULATE (\n        SUMX (\n            SUMMARIZE (\n                'Reporting PartnerOne',\n                'Reporting PartnerOne'[PartnerOne ID],\n                \"value\",1\n            ),\n            [value]\n        ),KEEPFILTERS('Partner Deal'[IsDealWith#PartnerGTM] = 1)\n    )",
            "formatString": "0",
            "lineageTag": "96fda8d2-a1f8-4288-8102-890d27a55e76"
          },
          {
            "name": "# Total Wins",
            "expression": "\nCALCULATE(\n    [# Partner Deals], \n    REMOVEFILTERS('Partner Deal'[IsDealWith#PartnerGTM]),\n    KEEPFILTERS('Partner Deal'[Partner Acceptance SubStatus(PartnerCenter)] = \"Won\"),\n    KEEPFILTERS(('Opportunity'[Consumption Status Reason] = \"Completed\" && \n                'Opportunity'[Consumption Status] = \"Closed\") || \n                'Opportunity'[Billed Revenue Status] = \"Won\"\n    )\n)",
            "formatString": "0",
            "lineageTag": "f72f862f-ff93-4047-9e15-ed463bb00b54"
          },
          {
            "name": "Partner Deal Revenue",
            "expression": "SUMX (\n    SUMMARIZE (\n        'Fact Partner Deal',\n        'Fact Partner Deal'[PartnerDealKey],\n        'Fact Partner Deal'[PartnerRevenueCD]\n    ),\n    [PartnerRevenueCD]\n)",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "lineageTag": "680f3ee0-f91d-4d2f-8702-140adeef98a1",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isDecimal\":true}"
              }
            ]
          },
          {
            "name": "# Inbound Referrals",
            "expression": "CALCULATE ( \n    [# Partner Deals], \n    KEEPFILTERS ( 'Partner Deal'[Partner Deal Direction] = \"Inbound\" ),\n    REMOVEFILTERS ( 'Partner Deal'[IsDealWith#PartnerGTM] )\n)",
            "formatString": "#,0",
            "lineageTag": "61cd1aae-5ae9-44ab-ab64-c37dbe631f2a"
          },
          {
            "name": "# Outbound Referrals ",
            "expression": "\nCALCULATE ( \n\n        [# Partner Deals], \n        KEEPFILTERS('Partner Deal'[Partner Deal Direction] = \"Outbound\") \n\n    ) ",
            "formatString": "0",
            "lineageTag": "24cc3419-0cea-43b2-83af-4b9f0f47f6d9"
          },
          {
            "name": "# Partner Deals PartnerGTM",
            "expression": "CALCULATE (\n        SUMX (\n            SUMMARIZE (\n                'Partner Deal',\n                'Partner Deal'[PartnerDealKey],\n                \"Value\",1\n            ),\n            [Value]\n        )\n    )",
            "formatString": "#,0",
            "lineageTag": "5fcfc23e-a97c-40b7-8da0-7b8275e027ae"
          },
          {
            "name": "Partner Reported # Wins",
            "expression": "\nCALCULATE ( \n        [# Partner Deals], \n        // ALL('Partner Deal'[IsDealWith#PartnerGTM]),\n        KEEPFILTERS('Partner Deal'[Partner Acceptance SubStatus(PartnerCenter)] = \"Won\")\n    )",
            "formatString": "0",
            "lineageTag": "e948d1a9-3ed7-4343-85f9-2c34c04b02fa"
          },
          {
            "name": "Partner Reported $ Wins",
            "expression": "\nCALCULATE ( \n        [Partner Deal Revenue], \n        KEEPFILTERS('Partner Deal'[Partner Acceptance SubStatus(PartnerCenter)] = \"Won\")\n    )",
            "formatString": "\\$#,0.###############;(\\$#,0.###############);\\$#,0.###############",
            "lineageTag": "fae87646-e397-45f6-9edc-c59d14fcc950",
            "changedProperties": [
              {
                "property": "FormatString"
              }
            ],
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ]
          },
          {
            "name": "# Inbound PartnerGTM Referrals",
            "expression": "\nCALCULATE ( \n\n        'Partner Deal'[# Partner Deals PartnerGTM], \n        KEEPFILTERS('Partner Deal'[Partner Deal Direction] = \"Inbound\") ,\n        KEEPFILTERS( 'Partner Deal'[IsDealWith#PartnerGTM] =1)\n    ) ",
            "formatString": "#,0",
            "lineageTag": "71330a83-d81e-4643-96b0-35b6fdef18e6"
          },
          {
            "name": "Marketing Contribution to Referrals %",
            "expression": "DIVIDE( [# Inbound PartnerGTM Referrals], [# Inbound Referrals old],0)",
            "formatString": "0%;-0%;0%",
            "lineageTag": "1135b794-ce2a-47d3-82b7-fba0ca7ccbcc"
          },
          {
            "name": "% Partners using #PartnerGTM",
            "expression": "\nDIVIDE(\n    [Partners using #PartnerGTM], \n    [# Partner Investment], \n    0\n)",
            "formatString": "0%;-0%;0%",
            "lineageTag": "29934e5c-c247-4fe3-828c-7d5c247c5028"
          },
          {
            "name": "Partner Deal Revenue (Aligned)",
            "expression": "\nCALCULATE(\n    [Partner Deal Revenue],\n    TREATAS(\n        VALUES(InvCustomPartnerReportingGeography[BigArea]),\n        CustomPartnerReportingGeography[BigArea]\n    )\n)",
            "formatString": "0",
            "lineageTag": "d9acb7b8-9c57-4bca-88c8-31d53e4c8e11",
            "changedProperties": [
              {
                "property": "Name"
              }
            ]
          },
          {
            "name": "# Partner Deals PartnerGTM (Aligned)",
            "expression": "\nCALCULATE(\n    [# Partner Deals PartnerGTM],\n    TREATAS(\n        VALUES(InvCustomPartnerReportingGeography[BigArea]),\n        CustomPartnerReportingGeography[BigArea]\n    )\n)",
            "formatString": "0",
            "lineageTag": "952a9e6a-7fbc-4d9a-9436-e1ca4331a731",
            "changedProperties": [
              {
                "property": "Name"
              }
            ]
          },
          {
            "name": "# Referrals",
            "expression": "CALCULATE (\n        SUMX (\n            SUMMARIZE (\n                'Partner Deal',\n                'Partner Deal'[PartnerDealKey],\n                \"Value\",1\n            ),\n            [Value]\n        )\n    )",
            "formatString": "0",
            "lineageTag": "448d27d1-9231-4547-ab94-93a13e73043d",
            "changedProperties": [
              {
                "property": "Name"
              }
            ]
          },
          {
            "name": "$ Referrals",
            "expression": "\n  SUMX (\n    SUMMARIZE (\n        'Fact Partner Deal',\n        'Fact Partner Deal'[PartnerDealKey],\n        'Fact Partner Deal'[PartnerRevenueCD]\n    ),\n    [PartnerRevenueCD]\n)",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "lineageTag": "dc9e63ff-21b3-49e9-b427-715b22bc84d7",
            "changedProperties": [
              {
                "property": "Name"
              },
              {
                "property": "FormatString"
              }
            ],
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ]
          },
          {
            "name": "# Inbound Referrals old",
            "expression": "\nCALCULATE ( \n\n        [# Partner Deals], \n        KEEPFILTERS('Partner Deal'[Partner Deal Direction] = \"Inbound\") \n\n    ) ",
            "formatString": "#,0",
            "lineageTag": "9debacc5-69b7-4a06-911b-4e93278246b7"
          },
          {
            "name": "# Inbound Active-Co-sell Referral",
            "expression": "CALCULATE ( \n    [# Partner Deals], \n    KEEPFILTERS ( 'Partner Deal'[Partner Deal Direction] = \"Inbound\" ),\n    KEEPFILTERS ( 'Partner Deal'[Referral SubType] = \"Active Co-sell - PC\" ),\n    REMOVEFILTERS ( 'Partner Deal'[IsDealWith#PartnerGTM] )\n)",
            "formatString": "#,0",
            "lineageTag": "8fc5eaf0-daf7-43be-9466-47489d2889e7"
          },
          {
            "name": "$ Inbound Referral",
            "expression": "CALCULATE (\n    SUMX (\n        SUMMARIZE (\n            'Fact Partner Deal',\n            'Fact Partner Deal'[PartnerDealKey],\n            'Fact Partner Deal'[PartnerRevenueCD]\n        ),\n        [PartnerRevenueCD]\n    ),\n    KEEPFILTERS ( 'Partner Deal'[Partner Deal Direction] = \"Inbound\" ),\n    REMOVEFILTERS ( 'Partner Deal'[IsDealWith#PartnerGTM] )\n)",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "lineageTag": "41f763d5-214d-4065-b4e9-d2bae85145cb",
            "changedProperties": [
              {
                "property": "FormatString"
              }
            ],
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ]
          },
          {
            "name": "$ Inbound Active-Co-sell Referral",
            "expression": "CALCULATE (\n    SUMX (\n        SUMMARIZE (\n            'Fact Partner Deal',\n            'Fact Partner Deal'[PartnerDealKey],\n            'Fact Partner Deal'[PartnerRevenueCD]\n        ),\n        [PartnerRevenueCD]\n    ),\n    KEEPFILTERS ( 'Partner Deal'[Partner Deal Direction] = \"Inbound\" ),\n    KEEPFILTERS ( 'Partner Deal'[Referral SubType] = \"Active Co-sell - PC\" ),\n    REMOVEFILTERS ( 'Partner Deal'[IsDealWith#PartnerGTM] )\n)",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "lineageTag": "a3c34d77-fd54-48af-9fe3-efc5c268035e",
            "changedProperties": [
              {
                "property": "FormatString"
              }
            ],
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ]
          },
          {
            "name": "Inbound Active-Co-sell Referral $ w/PartnerGTM",
            "expression": "CALCULATE (\n    SUMX (\n        SUMMARIZE (\n            'Fact Partner Deal',\n            'Fact Partner Deal'[PartnerDealKey],\n            'Fact Partner Deal'[PartnerRevenueCD]\n        ),\n        [PartnerRevenueCD]\n    ),\n    KEEPFILTERS ( 'Partner Deal'[Partner Deal Direction] = \"Inbound\" ),\n    KEEPFILTERS ( 'Partner Deal'[Referral SubType] = \"Active Co-sell - PC\" )\n)",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "lineageTag": "cc19bf66-5fe1-4a44-8d58-5a26ebec9160",
            "changedProperties": [
              {
                "property": "FormatString"
              }
            ],
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ]
          },
          {
            "name": "Inbound Active-Co-sell Referral # w/PartnerGTM",
            "expression": "CALCULATE ( \n    [# Partner Deals PartnerGTM], \n    KEEPFILTERS('Partner Deal'[Partner Deal Direction] = \"Inbound\"),\n    KEEPFILTERS('Partner Deal'[Referral SubType] = \"Active Co-sell - PC\")\n)",
            "formatString": "#,0",
            "lineageTag": "423c1e5f-fb29-4bea-adbb-f1496a801ddc"
          },
          {
            "name": "#% Inbound Active Co-sell",
            "expression": "DIVIDE (\n    [Inbound Active-Co-sell Referral # w/PartnerGTM],   \n    [# Inbound Active-Co-sell Referral],   -\n    0                    -- fallback when denominator is 0 or BLANK\n)",
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "5725511c-bc33-4b8e-87df-71800705255f",
            "changedProperties": [
              {
                "property": "FormatString"
              }
            ]
          },
          {
            "name": "$% Inbound Active Co-sell",
            "expression": "DIVIDE (\n    [Inbound Active-Co-sell Referral $ w/PartnerGTM],   \n    [$ Inbound Active-Co-sell Referral],  \n    0                    -- fallback when denominator is 0 or BLANK\n)",
            "formatString": "#,0.00%;-#,0.00%;#,0.00%",
            "lineageTag": "e72d4c77-f720-4d15-a922-95e4642b49be",
            "changedProperties": [
              {
                "property": "FormatString"
              }
            ]
          },
          {
            "name": "#% Acceptance",
            "expression": "DIVIDE (\n    [Co-sell Opportunities # (PartnerGTM)],\n    [Inbound Active-Co-sell Referral # w/PartnerGTM],   \n\n    0                    -- fallback when denominator is 0 or BLANK\n)",
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "49d5286f-82cc-4f6e-a858-7579e6caadce",
            "changedProperties": [
              {
                "property": "FormatString"
              }
            ]
          }
        ],
        "changedProperties": [
          {
            "property": "Name"
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
