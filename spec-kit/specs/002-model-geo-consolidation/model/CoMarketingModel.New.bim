        "partitions": [
          {
            "name": "InvestmentAsk",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "entityName": "InvestmentAsk",
              "expressionSource": "DatabaseQuery",
              "schemaName": "CoSell"
            }
          }
        ],
        "measures": [
          {
            "name": "Investment Approved Amount",
            "expression": "CALCULATE (\n        SUMX (\n            SUMMARIZE (\n                'Investment Ask',\n                'Investment Ask'[InvestmentAskID],\n                'Investment Ask'[ApprovedAmount]\n            ),\n            [ApprovedAmount]\n        ),ALL('Time'), ALL('Partner Deal'[IsDealWith#PartnerGTM])\n    )",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "lineageTag": "c4475f67-86ee-4404-a687-8b77d9687f4a",
            "changedProperties": [
              {
                "property": "FormatString"
              },
              {
                "property": "IsHidden"
              }
            ],
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ]
          },
          {
            "name": "# Partner Investment",
            "expression": "CALCULATE(\n    DISTINCTCOUNT('Investment Ask'[PartnerOneId]),\n    ALL('Partner Deal'[IsDealWith#PartnerGTM])\n)",
            "formatString": "0",
            "lineageTag": "2fd43468-3da3-4bd4-a0a4-ff8afd630de2",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ]
          },
          {
            "name": "Partner Co-Investment Approved Amount",
            "expression": "CALCULATE (\n        SUMX (\n            SUMMARIZE (\n                'Investment Ask',\n                'Investment Ask'[InvestmentAskID],\n                'Investment Ask'[Coinvestmentfrompartners]\n            ),\n            [Coinvestmentfrompartners]\n        ),ALL('Time'),'Investment Ask'[Stage] = \"Approved\", ALL('Partner Deal'[IsDealWith#PartnerGTM])\n    )",
            "formatString": "\\$#,0.###############;(\\$#,0.###############);\\$#,0.###############",
            "lineageTag": "bb1f5285-a9e7-4a9c-991c-dc72d4c57fea"
          },
          {
            "name": "# Estimated Opportunities",
            "expression": "CALCULATE(SUM('Investment Ask'[ForecastedSQLs]), 'Investment Ask'[Stage] = \"Approved\", ALL('Partner Deal'[IsDealWith#PartnerGTM]))",
            "formatString": "#,0",
            "lineageTag": "daa338f1-e1b3-4902-b33b-d63b1e5a89c0",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ]
          },
          {
            "name": "$ Estimated Pipeline Revenue",
            "expression": "CALCULATE(SUM('Investment Ask'[ForecastedRevenue]),'Investment Ask'[Stage] = \"Approved\", ALL('Partner Deal'[IsDealWith#PartnerGTM]))",
            "formatString": "\\$#,0.###############;(\\$#,0.###############);\\$#,0.###############",
            "lineageTag": "44f25862-24ae-4a39-8afa-42239e205596"
          },
          {
            "name": "# Estimated Opportunities Trailing18Months",
            "expression": "\nCALCULATE(\n    SUM('Investment Ask'[ForecastedSQLs]),\n    'Investment Ask'[Stage] = \"Approved\",\n    DATESINPERIOD(\n        'Investment Ask'[EstimatedCampaignStartDate],\n        TODAY(),\n        -18,\n        MONTH\n    )\n)",
            "formatString": "#,0",
            "lineageTag": "af949fba-f3ce-46d1-b56d-e6ee553a345a"
          },
          {
            "name": "# Microsoft Investment Trailing18Months",
            "expression": "\nCALCULATE(\n    COUNT('Investment Ask'[InvestmentAskID]),\n    'Investment Ask'[Stage] = \"Approved\",\n    DATESINPERIOD(\n        'Investment Ask'[EstimatedCampaignStartDate],\n        TODAY(),\n        -18,\n        MONTH\n    )\n)",
            "formatString": "#,0",
            "lineageTag": "050ed730-d13d-4d95-ae5c-ddcb70c7470e"
          },
          {
            "name": "# Shared Referrals Trailing18Months",
            "expression": "\nCALCULATE(\n    SUMX(\n        SUMMARIZE(\n            'Investment Ask',\n            'Investment Ask'[InvestmentAskID],\n            'Investment Ask'[ForecastedSQLs]\n        ),\n        [ForecastedSQLs]\n    ),\n    DATESINPERIOD(\n        'Investment Ask'[EstimatedCampaignStartDate],\n        TODAY(),\n        -18,\n        MONTH\n    )\n)",
            "formatString": "0",
            "lineageTag": "f5542703-e210-4415-9710-f62b97ef136e"
          },
          {
            "name": "Investment Approved Amount Trailing18Months",
            "expression": "\nCALCULATE(\n    SUMX(\n        SUMMARIZE(\n            'Investment Ask',\n            'Investment Ask'[InvestmentAskID],\n            'Investment Ask'[ApprovedAmount]\n        ),\n        [ApprovedAmount]\n    ),\n    DATESINPERIOD(\n        'Investment Ask'[EstimatedCampaignStartDate],\n        TODAY(),\n        -18,\n        MONTH\n    )\n)",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "lineageTag": "05c63cfd-2d3a-4893-9bba-d4a068878c03"
          },
          {
            "name": "Investment Requested Amount Trailing18Months",
            "expression": "\nCALCULATE(\n    SUMX(\n        SUMMARIZE(\n            'Investment Ask',\n            'Investment Ask'[InvestmentAskID],\n            'Investment Ask'[RequestedAmount]\n        ),\n        [RequestedAmount]\n    ),\n    DATESINPERIOD(\n        'Investment Ask'[EstimatedCampaignStartDate],\n        TODAY(),\n        -18,\n        MONTH\n    )\n)",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "lineageTag": "e12eaa21-0cd2-48dd-8254-24804573112f"
          },
          {
            "name": "Partner Co-Investment Approved Amount Trailing18Months",
            "expression": "\nCALCULATE(\n    SUMX(\n        SUMMARIZE(\n            'Investment Ask',\n            'Investment Ask'[InvestmentAskID],\n            'Investment Ask'[Coinvestmentfrompartners]\n        ),\n        [Coinvestmentfrompartners]\n    ),\n    DATESINPERIOD(\n        'Investment Ask'[EstimatedCampaignStartDate],\n        TODAY(),\n        -18,\n        MONTH\n    ),\n    'Investment Ask'[Stage] = \"Approved\"\n)",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "lineageTag": "c04b292b-c81f-4c65-8bab-31ee5f8f238c"
          },
          {
            "name": "Focused Areas",
            "expression": "\nCONCATENATEX(\n    DISTINCT(\n        SELECTCOLUMNS(\n            FILTER(\n                'CustomPartnerReportingGeography',\n                'CustomPartnerReportingGeography'[Subsidiary] IN\n                SELECTCOLUMNS('Inv Bridge Area', \"Subsidiary\", 'Inv Bridge Area'[Subsidiary])\n            ),\n            \"Area\", 'CustomPartnerReportingGeography'[Area]\n        )\n    ),\n    [Area],\n    \", \",\n    [Area],\n    ASC\n)\n",
            "lineageTag": "9367a97f-2efd-4f10-b844-165fff5edc2f",
            "changedProperties": [
              {
                "property": "Name"
              }
            ]
          },
          {
            "name": "InvestmentAsk_Areas_Improved",
            "expression": "\nCONCATENATEX(\n    DISTINCT(\n        SELECTCOLUMNS(\n            FILTER(\n                'CustomPartnerReportingGeography',\n                'CustomPartnerReportingGeography'[Subsidiary] IN\n                SELECTCOLUMNS('Inv Bridge Area', \"Subsidiary\", 'Inv Bridge Area'[Subsidiary])\n            ),\n            \"Area\", 'CustomPartnerReportingGeography'[Area]\n        )\n    ),\n    [Area],\n    \", \",\n    [Area],\n    ASC\n)\n",
            "lineageTag": "409b332a-f94a-415a-8d67-187d8c709588",
            "changedProperties": [
              {
                "property": "Name"
              }
            ]
          },
          {
            "name": "# Shared Referrals",
            "expression": "CALCULATE (\n        SUMX (\n            SUMMARIZE (\n                'Investment Ask',\n                'Investment Ask'[InvestmentAskID],\n                'Investment Ask'[ForecastedSQLs]\n            ),\n            [ForecastedSQLs]\n        )\n        ,ALL('Time'), ALL('Partner Deal'[IsDealWith#PartnerGTM])\n    )",
            "lineageTag": "e9ff2bf0-8937-4263-95ba-74f7216c5c1e",
            "changedProperties": [
              {
                "property": "Name"
              }
            ],
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "# Investment Ask",
            "expression": "CALCULATE (\n        DISTINCTCOUNT('Investment Ask'[InvestmentAskID]), ALL('Partner Deal'[IsDealWith#PartnerGTM])\n    )",
            "formatString": "0",
            "lineageTag": "cb1f4c54-14ef-46b9-9cc4-908b69ac2c5a",
            "changedProperties": [
              {
                "property": "Name"
              }
            ]
          },
          {
            "name": "# Investment Ask Trailing18Months",
            "expression": "\nCALCULATE(\n    SUMX(\n        SUMMARIZE(\n            'Investment Ask',\n            'Investment Ask'[InvestmentAskID],\n            \"Value\", 1\n        ),\n        [Value]\n    ),\n    DATESINPERIOD(\n        'Investment Ask'[EstimatedCampaignStartDate],\n        TODAY(),\n        -18,\n        MONTH\n    )\n)",
            "formatString": "0",
            "lineageTag": "ae9663ad-070e-4950-9166-33ffdd59314e",
            "changedProperties": [
              {
                "property": "Name"
              }
            ]
          },
          {
            "name": "$ Shared Referrals",
            "expression": "CALCULATE (\n        SUMX (\n            SUMMARIZE (\n                'Investment Ask',\n                'Investment Ask'[InvestmentAskID],\n                'Investment Ask'[ForecastedRevenue]\n            ),\n            [ForecastedRevenue]\n        ),ALL('Time'), ALL('Partner Deal'[IsDealWith#PartnerGTM])\n    )",
            "formatString": "0",
            "lineageTag": "f6eb1698-54e5-4931-a3c5-a5db7a35cd5f",
            "changedProperties": [
              {
                "property": "Name"
              },
              {
                "property": "FormatString"
              }
            ],
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isDecimal\":true}"
              }
            ]
          },
          {
            "name": "Investment Asks",
            "expression": "CALCULATE(DISTINCTCOUNT('Investment Ask'[InvestmentAskID]),ALL('Time'), ALL('Partner Deal'[IsDealWith#PartnerGTM]) )",
            "formatString": "0",
            "lineageTag": "caef5383-36b6-4b65-a0bd-6fe7359c3878",
            "changedProperties": [
              {
                "property": "Name"
              }
            ]
          },
          {
            "name": "Investment Partners",
            "expression": "CALCULATE (\n        DISTINCTCOUNT('Investment Ask'[PartnerOneId]),ALL('Time'), ALL('Partner Deal'[IsDealWith#PartnerGTM])//,FILTER(InvestmentAsk,InvestmentAsk[Account ID] <> \"NULL\")\n    )",
            "formatString": "0",
            "lineageTag": "ab68b157-004b-4185-b03f-f4839cb094eb",
            "changedProperties": [
              {
                "property": "Name"
              }
            ]
          },
          {
            "name": "Investment Requested Amount",
            "expression": "CALCULATE (\n        SUMX (\n            SUMMARIZE (\n                'Investment Ask',\n                'Investment Ask'[InvestmentAskID],\n                'Investment Ask'[RequestedAmount]\n            ),\n            [RequestedAmount]\n        ), ALL('Partner Deal'[IsDealWith#PartnerGTM])\n    )",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "lineageTag": "ff038318-d537-4ca7-874c-c0f2cb893902",
            "changedProperties": [
              {
                "property": "Name"
              }
            ]
          },
          {
            "name": "InvestmentAsk_Areas",
            "expression": "\nVAR CurrentInvestmentAskID = SELECTEDVALUE('Investment Ask'[InvestmentAskID])\nRETURN\nIF(\n    NOT ISBLANK(CurrentInvestmentAskID),\n    CONCATENATEX(\n        DISTINCT(\n            SELECTCOLUMNS(\n                FILTER(\n                    RELATEDTABLE('CustomPartnerReportingGeography'),\n                    'CustomPartnerReportingGeography'[Subsidiary] IN \n                    VALUES('Inv Bridge Area'[Subsidiary])\n                ),\n                \"Area\", 'CustomPartnerReportingGeography'[Area]\n            )\n        ),\n        [Area],\n        \", \",\n        [Area], ASC\n    ),\n    BLANK()\n)",
            "lineageTag": "a90f7630-0baa-4fd1-860e-25d90e4f6c7b",
            "changedProperties": [
              {
                "property": "Name"
              }
            ]
          },
          {
            "name": "Partner Co-Investment",
            "expression": "CALCULATE(sum('Investment Ask'[Coinvestmentfrompartners]), 'Investment Ask'[Stage] = \"Approved\")",
            "lineageTag": "b6d2d288-b09d-4388-b76b-8b7b3cbd7022",
            "changedProperties": [
              {
                "property": "Name"
              }
            ],
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "$ Approved (Global Investments)",
            "expression": "CALCULATE (\n    SUMX (\n        SUMMARIZE (\n            'Investment Ask',\n            'Investment Ask'[InvestmentAskID],\n            'Investment Ask'[ApprovedAmount]\n        ),\n        [ApprovedAmount]\n    ),\n    ALL('Time'),\n    ALL('Partner Deal'[IsDealWith#PartnerGTM]),\n    'Investment Ask'[InvestmentSource] = \"WW GTM Investments\"\n)",
            "lineageTag": "af6e4f0c-57ac-4910-ab21-7da4533c2cdb"
          },
          {
            "name": "Global Investment %",
            "expression": "DIVIDE ( [$ Approved (Global Investments)], [Investment Approved Amount] )",
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "7a44b5d4-0619-44db-a4b0-a19ba774140c",
            "changedProperties": [
              {
                "property": "FormatString"
              }
            ]
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
