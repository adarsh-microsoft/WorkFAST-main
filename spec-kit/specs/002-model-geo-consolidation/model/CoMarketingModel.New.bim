        "partitions": [
          {
            "name": "Engagement Milestone",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "entityName": "DimEngagementMilestoneCD",
              "expressionSource": "DatabaseQuery",
              "schemaName": "CoSell"
            }
          }
        ],
        "measures": [
          {
            "name": "Milestone Estimated Annualized Revenue Base",
            "expression": "\nVAR varMaxFiscalMonthID = 432  // FY25-June (This value should be last month of Next fiscal year)\nVAR varMaxEstFiscalMonthID = MIN( CALCULATE ( MAX('Engagement Milestone'[Estimated Fiscal Month ID])), 433) //FY26 July (This value should be one month ahead of the previous variable)\nVAR varIsNonRecurringMilestone = CALCULATE ( MAX( 'Engagement Milestone'[Is Non Recurring Engagement Milestone] ) )\nRETURN\n    IF ( varIsNonRecurringMilestone = \"No\"\n        ,CALCULATE( [Milestone Estimated Monthly Revenue] * IF( (varMaxFiscalMonthID - varMaxEstFiscalMonthID + 1) <= 0 || (varMaxFiscalMonthID - varMaxEstFiscalMonthID + 1) > 24\n                                                                ,BLANK()\n                                                                ,(varMaxFiscalMonthID - varMaxEstFiscalMonthID + 1) \n                                                            )\n                       \n            )\n        ,IF((varMaxFiscalMonthID - varMaxEstFiscalMonthID + 1) <= 0 || (varMaxFiscalMonthID - varMaxEstFiscalMonthID + 1) > 24, BLANK(), [Milestone Estimated Monthly Revenue])\n    )   ",
            "isHidden": true,
            "lineageTag": "f3ef23e2-15dd-40c5-a7c8-9ac6e12ce78b",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Milestone Estimated Annualized Revenue",
            "expression": "SUMX('Engagement Milestone',[Milestone Estimated Annualized Revenue Base])\n\n",
            "lineageTag": "f755b124-7f7d-4fdf-b391-6bf357545fea",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Milestone Estimated Monthly Revenue",
            "expression": "CALCULATE (\n        SUMX (\n            SUMMARIZE (\n                'Fact Engagement Milestone',\n                'Engagement Milestone'[EngagementMilestoneKey],\n                'Fact Engagement Milestone'[EstimatedMonthlyUsage]\n            ),\n            [EstimatedMonthlyUsage]\n        ),\n        KEEPFILTERS ( 'Fact Engagement Milestone'[IsMultiPartner] = \"no\" )\n    )",
            "isHidden": true,
            "lineageTag": "7ea6ad60-92ec-444d-83dc-418ef38c12e4",
            "changedProperties": [
              {
                "property": "IsHidden"
              },
              {
                "property": "FormatString"
              }
            ],
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          }
        ],
        "changedProperties": [
          {
            "property": "Name"
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
