        "measures": [
          {
            "name": "Funnel Common Measure",
            "expression": "\nSWITCH(\n    TRUE(),\n    SELECTEDVALUE('Funnel Category'[Chart Category]) = \"# Shared Referrals\", [# Partner Deals],\n    SELECTEDVALUE('Funnel Category'[Chart Category]) = \"# Pipeline Wins\", [# Pipeline Wins],\n    SELECTEDVALUE('Funnel Category'[Chart Category]) = \"# Shared Opportunities\", [# Shared Opportunities]\n)\n// IF(\n//     SELECTEDVALUE('Partner Deal'[Referral SubType]) = \"Partner Led - PC\",\n//     CALCULATE(\n//         SWITCH(\n//             TRUE(),\n//             SELECTEDVALUE('Funnel Category'[Chart Category]) = \"# Shared Referrals\", [# Partner Deals],\n//             SELECTEDVALUE('Funnel Category'[Chart Category]) = \"# Pipeline Wins\", [# Pipeline Wins],\n//             SELECTEDVALUE('Funnel Category'[Chart Category]) = \"# Shared Opportunities\", [# Shared Opportunities],\n//             BLANK()\n//         ),\n//         REMOVEFILTERS('Partner Deal'[Referral SubType])\n//     ),\n//     SWITCH(\n//         TRUE(),\n//         SELECTEDVALUE('Funnel Category'[Chart Category]) = \"# Shared Referrals\", [# Partner Deals],\n//         SELECTEDVALUE('Funnel Category'[Chart Category]) = \"# Pipeline Wins\", [# Pipeline Wins],\n//         SELECTEDVALUE('Funnel Category'[Chart Category]) = \"# Shared Opportunities\", [# Shared Opportunities]\n//     )\n// )",
            "formatString": "#,0",
            "lineageTag": "bfe8f11e-b32c-44e2-b115-0b604416752c",
            "changedProperties": [
              {
                "property": "IsHidden"
              },
              {
                "property": "FormatString"
              }
            ]
          },
          {
            "name": "Funnel Common Measure Partner Reporting",
            "expression": "\nSWITCH(\n    TRUE(),\n    SELECTEDVALUE('Funnel Category 2'[Chart Category]) = \"# Shared Referrals\", [# Partner Deals],\n    SELECTEDVALUE('Funnel Category 2'[Chart Category]) = \"Partner Reported # Wins\", [Partner Reported # Wins],\n    SELECTEDVALUE('Funnel Category 2'[Chart Category]) = \"# Shared Opportunities\", [# Shared Opportunities]\n)",
            "formatString": "0",
            "lineageTag": "6cefbb51-859e-49b5-aa77-a87e67f02135",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ]
          }
        ],
        "changedProperties": [
          {
            "property": "Name"
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
