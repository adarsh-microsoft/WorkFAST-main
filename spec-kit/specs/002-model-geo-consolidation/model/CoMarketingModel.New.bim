      },
      {
        "name": "DimSubsidiary",
        "description": "Conformed subsidiary spine introduced by Spec 002.\nReplaces the bidi-reliant chain DimAccountGeographyHierarchyReporting <-> BridgeGeography\n<-> CustomPartnerReportingGeography (and the Inv* twin) by becoming the single\nOne-side dim that every geo-bearing fact and dim snowflakes into.",
        "lineageTag": "e2c11000-0001-4000-9000-000000000001",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "SubsidiaryId",
            "dataType": "string",
            "isNameInferred": false,
            "isKey": true,
            "sourceColumn": "[SubsidiaryId]",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculatedTableColumn",
            "name": "SubsidiaryName",
            "dataType": "string",
            "isNameInferred": false,
            "sourceColumn": "[SubsidiaryName]",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculatedTableColumn",
            "name": "FieldSubsidiary",
            "dataType": "string",
            "isNameInferred": false,
            "sourceColumn": "[FieldSubsidiary]",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          }
        ],
        "partitions": [
          {
            "name": "DimSubsidiary",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": "ADDCOLUMNS(\n\tDISTINCT(\n\t\tSELECTCOLUMNS(\n\t\t\t'DimAccountGeographyHierarchyReporting',\n\t\t\t\"SubsidiaryId\", 'DimAccountGeographyHierarchyReporting'[SubsidiaryId],\n\t\t\t\"SubsidiaryName\", 'DimAccountGeographyHierarchyReporting'[SubsidiaryName]\n\t\t)\n\t),\n\t\"FieldSubsidiary\", [SubsidiaryName]\n)"
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
      {
        "name": "DimInvestmentSource",
        "description": "Conformed Investment Source dim. Replaces the bidi pair\nInvestment Ask[InvestmentSource] <-> BridgeInvestmentSource <-> Comarketing TPM Budget[Investment Source]\nby making this table the One side that both facts join into M:1 single-direction.\nThe legacy BridgeInvestmentSource is kept for back-compat reads but is no longer the join hub.",
        "lineageTag": "e2c11000-0001-4000-9000-000000000002",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "InvestmentSource",
            "dataType": "string",
            "isNameInferred": false,
            "isKey": true,
            "sourceColumn": "[InvestmentSource]",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          }
        ],
        "partitions": [
          {
            "name": "DimInvestmentSource",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": "DISTINCT(\n\tUNION(\n\t\tSELECTCOLUMNS(BridgeInvestmentSource, \"InvestmentSource\", BridgeInvestmentSource[InvestmentSource]),\n\t\tSELECTCOLUMNS('Investment Ask',         \"InvestmentSource\", 'Investment Ask'[InvestmentSource]),\n\t\tSELECTCOLUMNS('Comarketing TPM Budget', \"InvestmentSource\", 'Comarketing TPM Budget'[Investment Source])\n\t)\n)"
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
      {
        "name": "BridgeFunnelCategory",
        "description": "Bridge that converts the M:M Fact Partner Deal[Category] <-> Funnel Category[Actual Category]\nedge into two single-direction M:1 edges (Fact -> Bridge, Funnel Category -> Bridge),\nso the original bidi can be dropped while preserving the shared key surface.\nForward filter (Funnel Category attributes -> facts) flows through the bridge.\nReverse filter (fact narrowing the visible category list) is preserved by single-direction\npropagation because Fact Partner Deal[Category] is also Many on the bridge.",
        "lineageTag": "e2c11000-0001-4000-9000-000000000003",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "Actual Category",
            "dataType": "string",
            "isNameInferred": false,
            "isKey": true,
            "sourceColumn": "[Actual Category]",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          }
        ],
        "partitions": [
          {
            "name": "BridgeFunnelCategory",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": "DISTINCT(\n\tUNION(\n\t\tSELECTCOLUMNS('Funnel Category',    \"Actual Category\", 'Funnel Category'[Actual Category]),\n\t\tSELECTCOLUMNS('Fact Partner Deal',  \"Actual Category\", 'Fact Partner Deal'[Category])\n\t)\n)"
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
      {
        "name": "BridgeFunnelCategory2",
        "description": "Twin of BridgeFunnelCategory for the Category2 axis.\nReplaces the M:M bidi Fact Partner Deal[Category2] <-> Funnel Category 2[Actual Category]\nwith two single-direction M:1 edges into this bridge.",
        "lineageTag": "e2c11000-0001-4000-9000-000000000004",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "Actual Category",
