            "dataType": "double",
            "sourceColumn": "Revenue",
            "lineageTag": "1f3a56c1-e271-452b-a8f9-82098450929a",
            "summarizeBy": "sum",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          }
        ],
        "partitions": [
          {
            "name": "Comarketing TPM Budget",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "entityName": "ComarketingTPMBudget",
              "expressionSource": "DatabaseQuery",
              "schemaName": "CoSell"
            }
          }
        ],
        "measures": [
          {
            "name": "% TPM Budget Tracked",
            "expression": "DIVIDE('Investment Ask'[Investment Approved Amount], 'Comarketing TPM Budget'[# Budget Sum], 0)",
            "lineageTag": "9fa3a5d8-1dc8-4867-ad70-ee9db789100e",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "# Budget Sum",
            "expression": "\nCALCULATE(\n    SUM ( 'Comarketing TPM Budget'[Revenue] ),\n    REMOVEFILTERS ( 'Time' )\n)",
            "formatString": "0",
            "lineageTag": "74147ec9-3682-4c29-be29-e5b0e2ae4beb"
          },
          {
            "name": "% Partner TPM Matched",
            "expression": "'Investment Ask'[Partner Co-Investment Approved Amount] / 'Investment Ask'[Investment Approved Amount]",
            "lineageTag": "f85ddc8e-a506-419b-ba38-248c00ba97dd",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          }
        ],
        "changedProperties": [
          {
            "property": "Name"
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
