            "name": "Marketplace Leads",
            "expression": "\nCALCULATE(\n    'Partner Deal'[# Partner Deals],\n    FILTER(\n        'Fact Partner Deal',\n        'Fact Partner Deal'[IsMarketplaceDealReg] = \"Yes\"\n    )\n)",
            "formatString": "0",
            "lineageTag": "a9be3e8b-da1a-495b-aa53-03e4627ff8b1"
          }
        ],
