        "partitions": [
          {
            "name": "Opportunity",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "entityName": "DimOpportunityCD",
              "expressionSource": "DatabaseQuery",
              "schemaName": "CoSell"
            }
          }
        ],
        "measures": [
          {
            "name": "# Shared Opportunities",
            "expression": "CALCULATE (\n        SUMX (\n            SUMMARIZE (\n                'Opportunity',\n                'Opportunity'[Opportunity Number],\n                \"Value\",1\n            ),\n            [Value]\n        ),KEEPFILTERS('Partner Deal'[IsDealWith#PartnerGTM] = 1)\n        ,FILTER('Partner Deal','Partner Deal'[Referral Microsoft SubStatus(PartnerCenter)] = \"Accepted\" \n        || 'Partner Deal'[Partner Acceptance SubStatus(PartnerCenter)] = \"Accepted\")\n    )",
            "formatString": "#,0",
            "lineageTag": "0fb6c92b-66ae-453d-a9a0-a16ad3b7ae64",
            "changedProperties": [
              {
                "property": "FormatString"
              }
            ]
          },
          {
            "name": "# Pipeline Wins",
            "expression": "CALCULATE (\n        SUMX (\n            SUMMARIZE (\n                'Opportunity',\n                'Opportunity'[Opportunity Number],\n                \"Value\",1\n            ),\n            [Value]\n        )\n        ,KEEPFILTERS('Partner Deal'[IsDealWith#PartnerGTM] = 1)\n        ,FILTER('Partner Deal','Partner Deal'[Referral Microsoft SubStatus(PartnerCenter)] = \"Accepted\" \n            || 'Partner Deal'[Partner Acceptance SubStatus(PartnerCenter)] = \"Accepted\" || 'Partner Deal'[Partner Acceptance SubStatus(PartnerCenter)] = \"Won\")\n        ,FILTER('Opportunity','Opportunity'[Billed Revenue Status] = \"Won\" \n            || ('Opportunity'[Consumption Status] = \"Closed\" && 'Opportunity'[Consumption Status Reason] = \"Completed\")\n    ))",
            "formatString": "#,0",
            "lineageTag": "7199cc22-491e-490e-be34-59f11ad887f2",
            "changedProperties": [
              {
                "property": "FormatString"
              }
            ]
          },
          {
            "name": "$ Shared Opportunities",
            "expression": "\nCALCULATE(\n    [Billed Opportunity Revenue] + [Milestone Estimated Annualized Revenue],\n    KEEPFILTERS ( 'Partner Deal'[IsDealWith#PartnerGTM] = 1 ),\n    KEEPFILTERS (\n        FILTER(\n            'Partner Deal',\n            'Partner Deal'[Referral Microsoft SubStatus(PartnerCenter)] = \"Accepted\"\n                || 'Partner Deal'[Partner Acceptance SubStatus(PartnerCenter)] = \"Accepted\"\n        )\n    )\n)\n",
            "formatString": "\\$#,0.###############;(\\$#,0.###############);\\$#,0.###############",
            "lineageTag": "010f1cdd-d008-49d7-82fa-7d4808f87b84",
            "changedProperties": [
              {
                "property": "FormatString"
              }
            ]
          },
          {
            "name": "$ Pipeline Wins",
            "expression": "\nCALCULATE([$ Shared Opportunities dup],\n            // REMOVEFILTERS('Partner Deal'[Referral SubType]),\n          FILTER('Opportunity','Opportunity'[Billed Revenue Status] = \"Won\" \n             || ('Opportunity'[Consumption Status] = \"Closed\" && 'Opportunity'[Consumption Status Reason] = \"Completed\")\n    )\n)",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "lineageTag": "3b245b23-db84-4c03-aa59-5695b638d03c",
            "changedProperties": [
              {
                "property": "FormatString"
              }
            ]
          },
          {
            "name": "ROI old",
            "expression": "DIVIDE([$ Pipeline Wins], [Investment Approved Amount])",
            "formatString": "0%;-0%;0%",
            "lineageTag": "7b950c5e-4d31-42c2-b1e2-468cdf48e0ee",
            "changedProperties": [
              {
                "property": "FormatString"
              }
            ]
          },
          {
            "name": "Billed Opportunity Revenue",
            "expression": "CALCULATE (\n        SUMX (\n            SUMMARIZE (\n                'Fact Opportunity',\n                'Fact Opportunity'[OpportunityKey],\n                'Fact Opportunity'[ProductKey],\n                'Fact Opportunity'[RevSumDivisionKey],\n                'Fact Opportunity'[OpportunityRevenue]\n            ),\n            [OpportunityRevenue]\n        ),\n        KEEPFILTERS ( 'Fact Opportunity'[IsMultiPartner] = \"no\" ),\n        KEEPFILTERS ( 'Opportunity'[Is Billed Opportunity] = \"Yes\" ),\n        KEEPFILTERS ( 'Opportunity'[Opportunity Due Fiscal Year] IN {\"FY23\",\"FY24\",\"FY25\",\"FY26\"} )\n    )",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "lineageTag": "6be6529e-6d56-4656-b2cc-06c9b7684b9e",
            "changedProperties": [
              {
                "property": "FormatString"
              },
              {
                "property": "IsHidden"
              }
            ]
          },
          {
            "name": "# Oppty",
            "expression": "CALCULATE (\n        SUMX (\n            SUMMARIZE (\n                'Opportunity',\n                'Opportunity'[Opportunity Number],\n                \"Value\",1\n            ),\n            [Value]\n        )\n    )",
            "formatString": "#,0",
            "lineageTag": "f8101c11-c03c-474e-8f52-6a329b687f05"
          },
          {
            "name": "# Shared Inbound Opportunities ",
            "expression": "\nCALCULATE(\n    [# Oppty],\n    KEEPFILTERS('Partner Deal'[Partner Deal Direction] = \"Inbound\")\n)",
            "formatString": "#,0",
            "lineageTag": "c564294e-5149-4d7b-919b-4056385dc123"
          },
          {
            "name": "# Shared Outbound Opportunities",
            "expression": "\nCALCULATE(\n    [# Oppty],\n    KEEPFILTERS('Partner Deal'[Partner Deal Direction] = \"Outbound\")\n)",
            "formatString": "#,0",
            "lineageTag": "ac06c3a6-bb87-4524-b577-ad3914d44664"
          },
          {
            "name": "Inbound Oppty Wins",
            "expression": "\nCALCULATE (\n    [# Oppty],\n    KEEPFILTERS('Partner Deal'[Partner Deal Direction] = \"Inbound\"),\n    KEEPFILTERS(\n        ('Opportunity'[Consumption Status Reason] = \"Completed\" &&\n        'Opportunity'[Consumption Status] = \"Closed\") ||\n        'Opportunity'[Billed Revenue Status] = \"Won\"\n    )\n)",
            "formatString": "0",
            "lineageTag": "52c73716-3165-4eb5-8853-48bf2b0d8ca7"
          },
          {
            "name": "Outbound Oppty Wins",
            "expression": "\nCALCULATE (\n    [# Oppty],\n    KEEPFILTERS('Partner Deal'[Partner Deal Direction] = \"Outbound\"),\n    KEEPFILTERS(\n        ('Opportunity'[Consumption Status Reason] = \"Completed\" &&\n        'Opportunity'[Consumption Status] = \"Closed\") ||\n        'Opportunity'[Billed Revenue Status] = \"Won\"\n    )\n)",
            "formatString": "0",
            "lineageTag": "6e65893f-4bb4-4bf7-9df5-ff02a8acfed4"
          },
          {
            "name": "# Partner GTM Shared Pipeline Growth",
            "expression": "\nCALCULATE(\n    [# Oppty],\n    KEEPFILTERS(\n        'Partner Deal'[Partner Deal Direction] IN {\"Inbound\", \"Outbound\"}\n    ),\n    KEEPFILTERS('Partner Deal'[IsDealWith#PartnerGTM] = 1)\n)",
            "formatString": "#,0",
            "lineageTag": "e0c0a7ea-880e-4581-b4c1-c74612976c69"
          },
          {
            "name": "# Shared Opportunities Won",
            "expression": "\nCALCULATE(\n    [# Oppty],\n    KEEPFILTERS('Sharing Type'[SharingType] = \"Shared\"),\n    KEEPFILTERS(\n        'Opportunity'[Billed Revenue Status] = \"Won\"\n    )\n)\n\n\n",
            "formatString": "#,0",
            "lineageTag": "3ffd28e4-8f73-4a18-8d6a-33d4f0eee5f3"
          },
          {
            "name": "# All Up Shared Pipeline Growth",
            "expression": "\nIF(SELECTEDVALUE('Partner Deal'[Referral SubType]) = \"Partner Led - PC\",\nCALCULATE(\n    [# Oppty],\n    REMOVEFILTERS('Partner Deal'[IsDealWith#PartnerGTM]),\n    REMOVEFILTERS('Partner Deal'[Referral SubType]),\n    KEEPFILTERS(\n        'Partner Deal'[Partner Deal Direction] IN {\"Inbound\", \"Outbound\"}\n    )\n),\nCALCULATE(\n    [# Oppty],\n    REMOVEFILTERS('Partner Deal'[IsDealWith#PartnerGTM]),\n    KEEPFILTERS(\n        'Partner Deal'[Partner Deal Direction] IN {\"Inbound\", \"Outbound\"}\n    )\n))",
            "formatString": "#,0",
            "lineageTag": "b1ed45de-3ef8-43ad-8751-61ad8ac608d6"
          },
          {
            "name": "# All up Shared Opportunities",
            "expression": "CALCULATE (\n        SUMX (\n            SUMMARIZE (\n                'Opportunity',\n                'Opportunity'[Opportunity Number],\n                \"Value\",1\n            ),\n            [Value]\n        ),ALL('Partner Deal'[IsDealWith#PartnerGTM])\n        ,FILTER('Partner Deal','Partner Deal'[Referral Microsoft SubStatus(PartnerCenter)] = \"Accepted\" \n        || 'Partner Deal'[Partner Acceptance SubStatus(PartnerCenter)] = \"Accepted\")\n    )",
            "formatString": "#,0",
            "lineageTag": "70164565-7dad-4b03-bfc3-f88b290e16ed"
          },
          {
            "name": "$ All Up Shared Opportunities",
            "expression": "\nCALCULATE(\n    [Billed Opportunity Revenue] + [Milestone Estimated Annualized Revenue],\n    REMOVEFILTERS('Partner Deal'[IsDealWith#PartnerGTM])\n)",
            "formatString": "\\$#,0.###############;(\\$#,0.###############);\\$#,0.###############",
            "lineageTag": "ca74ddea-548f-4d8a-beb3-0a61f73a6fd7"
          },
          {
            "name": "# Shared Opportunities dup",
            "expression": "\nVAR IsPartnerLedPC = SELECTEDVALUE('Partner Deal'[Referral SubType]) = \"Partner Led - PC\"\n \nVAR TotalWithAllSubTypes =\n    CALCULATE(CALCULATE (\n        SUMX (\n            SUMMARIZE (\n                'Opportunity',\n                'Opportunity'[Opportunity Number],\n                \"Value\", 1\n            ),\n            [Value]\n        ),\n        KEEPFILTERS('Partner Deal'[IsDealWith#PartnerGTM] = 1),\n        FILTER (\n            'Partner Deal',\n            'Partner Deal'[Referral Microsoft SubStatus(PartnerCenter)] = \"Accepted\" ||\n            'Partner Deal'[Partner Acceptance SubStatus(PartnerCenter)] = \"Accepted\"\n        )\n         -- Remove slicer filter only on Referral SubType\n    ),REMOVEFILTERS('Partner Deal'[Referral SubType]))\n \nVAR TotalWithCurrentSelection =\n    CALCULATE (\n        SUMX (\n            SUMMARIZE (\n                'Opportunity',\n                'Opportunity'[Opportunity Number],\n                \"Value\", 1\n            ),\n            [Value]\n        ),\n        KEEPFILTERS('Partner Deal'[IsDealWith#PartnerGTM] = 1),\n        FILTER (\n            'Partner Deal',\n            'Partner Deal'[Referral Microsoft SubStatus(PartnerCenter)] = \"Accepted\" ||\n            'Partner Deal'[Partner Acceptance SubStatus(PartnerCenter)] = \"Accepted\"\n        )\n    )\n \nRETURN\n    IF (IsPartnerLedPC, TotalWithAllSubTypes, TotalWithCurrentSelection)",
            "formatString": "#,0",
            "lineageTag": "c07f893b-9ec1-49ff-b08a-dbca80eea2e7",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ]
          },
          {
            "name": "$ Shared Opportunities dup",
            "expression": "\nVAR Base = [$ Shared Opportunities]\nVAR SubType = SELECTEDVALUE('Partner Deal'[Referral SubType])\nRETURN\nIF(\n    HASONEVALUE('Partner Deal'[Referral SubType])\n        && SubType = \"Partner Led - PC\",\n    CALCULATE(\n        Base,\n        REMOVEFILTERS('Partner Deal'[Referral SubType])\n    ),\n    Base\n)\n",
            "formatString": "\\$#,0.###############;(\\$#,0.###############);\\$#,0.###############",
            "lineageTag": "ace7bafa-c687-41b4-a1fb-2ba8c000691a",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ]
          },
          {
            "name": "# All Up Shared Pipeline Growth dup",
            "expression": "\nIF(SELECTEDVALUE('Partner Deal'[Referral SubType]) = \"Partner Led - PC\",\nCALCULATE(\n    [# Oppty],\n    REMOVEFILTERS('Partner Deal'[IsDealWith#PartnerGTM]),\n    REMOVEFILTERS('Partner Deal'[Referral SubType]),\n    KEEPFILTERS(\n        'Partner Deal'[Partner Deal Direction] IN {\"Inbound\", \"Outbound\"}\n    )\n),\nCALCULATE(\n    [# Oppty],\n    REMOVEFILTERS('Partner Deal'[IsDealWith#PartnerGTM]),\n    KEEPFILTERS(\n        'Partner Deal'[Partner Deal Direction] IN {\"Inbound\", \"Outbound\"}\n    )\n))",
            "formatString": "#,0",
            "isHidden": true,
            "lineageTag": "3efd58e7-e857-4db1-b597-97facb72b8ec",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ]
          },
          {
            "name": "$ All Up Shared Opportunities dup",
            "expression": "IF(SELECTEDVALUE('Partner Deal'[Referral SubType]) = \"Partner Led - PC\",\nCALCULATE(\n    [Billed Opportunity Revenue] + [Milestone Estimated Annualized Revenue],\n    REMOVEFILTERS('Partner Deal'[Referral SubType]),\n    REMOVEFILTERS('Partner Deal'[IsDealWith#PartnerGTM])\n    \n),\nCALCULATE(\n    [Billed Opportunity Revenue] + [Milestone Estimated Annualized Revenue],\n    REMOVEFILTERS('Partner Deal'[IsDealWith#PartnerGTM])\n))",
            "formatString": "\\$#,0.###############;(\\$#,0.###############);\\$#,0.###############",
            "isHidden": true,
            "lineageTag": "4169435c-7b71-4f25-a658-9ab73593b878",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ]
          },
          {
            "name": "# Partner GTM Shared Pipeline Growth dup",
            "expression": "\nVAR IsPartnerLedPC = SELECTEDVALUE('Partner Deal'[Referral SubType]) = \"Partner Led - PC\"\n \nVAR TotalWithAllSubTypes =\n    CALCULATE(CALCULATE(\n        [# Oppty],\n        KEEPFILTERS(\n            'Partner Deal'[Partner Deal Direction] IN { \"Inbound\", \"Outbound\" }\n        ),\n        KEEPFILTERS('Partner Deal'[IsDealWith#PartnerGTM] = 1),\n        REMOVEFILTERS('Partner Deal'[Referral SubType]) ),REMOVEFILTERS('Partner Deal'[Referral SubType]))\n \nVAR TotalWithCurrentSelection =\n    CALCULATE(\n        [# Oppty], -- Base measure\n        KEEPFILTERS(\n            'Partner Deal'[Partner Deal Direction] IN { \"Inbound\", \"Outbound\" }\n        ),\n        KEEPFILTERS('Partner Deal'[IsDealWith#PartnerGTM] = 1)\n    )\n \nRETURN\n    IF(IsPartnerLedPC, TotalWithAllSubTypes, TotalWithCurrentSelection)\n \n ",
            "formatString": "#,0",
            "isHidden": true,
            "lineageTag": "15761dfe-b8ff-40f7-a1c7-8dda0ea682ce",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ]
          },
          {
            "name": "Percent of Previous",
            "expression": "DIVIDE( [# Shared Opportunities dup], [# Partner Deals PartnerGTM])",
            "lineageTag": "16f0eaec-add0-4d38-8a8a-fa5dc0c0610b",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Percent of Next",
            "expression": "DIVIDE([# Shared Opportunities Won],[# Shared Opportunities dup])",
            "lineageTag": "eff0b390-0b00-4c01-9344-7b311417c518",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "$ Pipeline Wins dup",
            "expression": "\nVAR IsPartnerLedPC = SELECTEDVALUE('Partner Deal'[Referral SubType]) = \"Partner Led - PC\"\n \nVAR TotalWithAllSubTypes =\n    CALCULATE(CALCULATE (\n        [$ Shared Opportunities],\n        FILTER (\n            'Opportunity',\n            'Opportunity'[Billed Revenue Status] = \"Won\" ||\n            ('Opportunity'[Consumption Status] = \"Closed\" && 'Opportunity'[Consumption Status Reason] = \"Completed\")\n        )\n    ),REMOVEFILTERS('Partner Deal'[Referral SubType]) )\n \nVAR TotalWithCurrentSelection =\n    CALCULATE (\n        [$ Shared Opportunities],\n        FILTER (\n            'Opportunity',\n            'Opportunity'[Billed Revenue Status] = \"Won\" ||\n            ('Opportunity'[Consumption Status] = \"Closed\" && 'Opportunity'[Consumption Status Reason] = \"Completed\")\n        )\n    )\n \nRETURN\n    IF (IsPartnerLedPC, TotalWithAllSubTypes, TotalWithCurrentSelection)",
            "formatString": "\\$#,0.###############;(\\$#,0.###############);\\$#,0.###############",
            "isHidden": true,
            "lineageTag": "3001e9d0-39d8-4497-b28a-f397c6d95d66",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ]
          },
          {
            "name": "# Shared Opportunities (Aligned)",
            "expression": "\nCALCULATE(\n    [# Shared Opportunities],\n    TREATAS(\n        VALUES(InvCustomPartnerReportingGeography[BigArea]),\n        CustomPartnerReportingGeography[BigArea]\n    )\n)",
            "formatString": "0",
            "lineageTag": "64f874cc-b975-4c07-9821-30ed8096a2bb",
            "changedProperties": [
              {
                "property": "Name"
              }
            ]
          },
          {
            "name": "$ Shared Opportunities (Aligned)",
            "expression": "\nCALCULATE(\n    [$ Shared Opportunities],\n    TREATAS(\n        VALUES(InvCustomPartnerReportingGeography[BigArea]),\n        CustomPartnerReportingGeography[BigArea]\n    )\n)",
            "lineageTag": "80bced8b-6fdb-46b1-a601-8f63adb43359",
            "changedProperties": [
              {
                "property": "Name"
              }
            ],
            "annotations": [
              {
                "name": "PBI_FormatHint",
