        "measures": [
          {
            "name": "Total Spend",
            "expression": "\nCALCULATE(\n    SUMX(\n        SUMMARIZE('Fact IOPO'\n                 ,'Fact IOPO'[IOPOKey]\n                 ,'Fact IOPO'[DateTimeKey]\n                 ,'Fact IOPO'[Actual]\n        ),[Actual] \n    ),\n    ALL('Time')\n)",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "lineageTag": "22a3ef02-2e33-43ba-a3de-2bbfeeabd8c3",
            "changedProperties": [
              {
                "property": "FormatString"
              }
            ],
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ]
          },
          {
            "name": "Open PO",
            "expression": "\nCALCULATE(\n    SUMX(\n        SUMMARIZE('Fact IOPO'\n                 ,'Fact IOPO'[IOPOKey]\n                 ,'Fact IOPO'[DateTimeKey]\n                 ,'Fact IOPO'[PO Vendor Name]\n                 ,'Fact IOPO'[PO Line Item & Description]\n                 ,'Fact IOPO'[OpenAmount]\n        ),[OpenAmount] \n    )\n)",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "lineageTag": "dc8a6318-da50-4ea5-a89a-5f4eeab4ce02",
            "changedProperties": [
              {
                "property": "FormatString"
              }
            ],
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ]
          },
          {
            "name": "Invoice Amount",
            "expression": "\nCALCULATE(\n    SUMX(\n        SUMMARIZE('Fact IOPO'\n                 ,'Fact IOPO'[IOPOKey]\n                 ,'Fact IOPO'[DateTimeKey]\n                 ,'Fact IOPO'[PO Vendor Name]\n                 ,'Fact IOPO'[PO Line Item & Description]\n                 ,'Fact IOPO'[InvoicedAmount]\n        ),[InvoicedAmount] \n    )\n)",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "lineageTag": "4434219e-82ce-490f-a4ff-79615d34f867",
            "changedProperties": [
              {
                "property": "FormatString"
              }
            ]
          },
          {
            "name": "PO Amount",
            "expression": "\nCALCULATE(\n    SUMX(\n        SUMMARIZE('Fact IOPO'\n                 ,'Fact IOPO'[IOPOKey]\n                 ,'Fact IOPO'[DateTimeKey]\n                 ,'Fact IOPO'[PO Vendor Name]\n                 ,'Fact IOPO'[PO Line Item & Description]\n                 ,'Fact IOPO'[POAmount]\n        ),[POAmount] \n    )\n)",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "lineageTag": "bb500877-ec91-4604-82ab-5449e4a2e5f9",
            "changedProperties": [
              {
                "property": "FormatString"
              }
            ]
          },
          {
            "name": "Committed Amount",
            "expression": "CALCULATE([Open PO] + [Spend],ALL('Time'))",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "lineageTag": "3f966db4-d4cc-44f0-8b33-30ffa83b716e",
            "changedProperties": [
              {
                "property": "FormatString"
              }
            ],
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ]
          },
          {
            "name": "JE/Accrual",
            "expression": "\nCALCULATE(\n    [Spend],\n    FILTER('IOPO', 'IOPO'[PO Number] = \"0\")\n)",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "lineageTag": "d776dca0-db71-4e10-887e-6f09e661a488",
            "changedProperties": [
              {
                "property": "FormatString"
              }
            ]
          },
          {
            "name": "Committed",
            "expression": "[Open PO] + [Spend]",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "lineageTag": "efb78a8b-1c69-4e93-a0d6-e2a5e6e3e8c7",
            "changedProperties": [
              {
                "property": "FormatString"
              }
            ]
          },
          {
            "name": "Spend",
            "expression": "CALCULATE(\n    SUMX(\n        SUMMARIZE('Fact IOPO'\n                 ,'Fact IOPO'[IOPOKey]\n                 ,'Fact IOPO'[DateTimeKey]\n                 ,'Fact IOPO'[Actual]\n        ),[Actual] \n    )\n)",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "lineageTag": "47eb9937-7185-4275-9c07-91571d2e3b23",
            "changedProperties": [
              {
                "property": "FormatString"
              }
            ]
          },
          {
            "name": "Total Spend Trailing18Months",
            "expression": "\nCALCULATE(\n    SUMX(\n        SUMMARIZE(\n            'Fact IOPO',\n            'Fact IOPO'[IOPOKey],\n            'Fact IOPO'[DateTimeKey],\n            'Fact IOPO'[Actual]\n        ),\n        [Actual]\n    )\n    ,\n    DATESINPERIOD(\n        'Time'[Date],\n        TODAY(),\n        -18,\n        MONTH\n    )\n)",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "lineageTag": "e914e8a2-4621-4d3d-b282-5580b97df499"
          }
        ],
        "changedProperties": [
          {
            "property": "Name"
          }
        ],
