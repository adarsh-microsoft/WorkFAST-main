        "measures": [
          {
            "name": "Partner Deals with Transactable Solution",
            "expression": "\nCALCULATE(\n    'Partner Deal'[# Partner Deals],\n    FILTER(\n        'Fact Partner Deal',\n        RELATED(Solution[Is Transactable In MarketPlace]) = \"Yes\"\n    )\n)",
            "formatString": "0",
            "lineageTag": "9d92fe63-0ebd-4540-908d-1ce9ca51e335"
          },
