              }
            ]
          },
          {
            "name": "# Pipeline Wins (Aligned)",
            "expression": "\nCALCULATE(\n    [# Pipeline Wins],\n    TREATAS(\n        VALUES(InvCustomPartnerReportingGeography[BigArea]),\n        CustomPartnerReportingGeography[BigArea]\n    )\n)",
            "formatString": "0",
            "lineageTag": "a396d45d-7766-49de-afde-e6bcf3e1db67",
            "changedProperties": [
              {
                "property": "Name"
              }
            ]
          },
          {
            "name": "$ Pipeline Wins (Aligned)",
            "expression": "\nCALCULATE(\n    [$ Pipeline Wins],\n    TREATAS(\n        VALUES(InvCustomPartnerReportingGeography[BigArea]),\n        CustomPartnerReportingGeography[BigArea]\n    )\n)",
            "lineageTag": "1e9ad818-f7f6-4a6d-8c45-6f86d21e18e8",
            "changedProperties": [
              {
                "property": "Name"
              }
            ],
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Oppty ROI",
            "expression": "DIVIDE([Co-sell Opportunities $ (PartnerGTM)], [Investment Approved Amount])",
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "9892572d-476c-461f-939e-bdb0ef5110c1",
            "changedProperties": [
              {
                "property": "Name"
              },
              {
                "property": "FormatString"
              }
            ]
          },
          {
            "name": "$ Shared Opportunities Stage 1",
            "expression": "\nCALCULATE(\n    [Billed Opportunity Revenue] + [Milestone Estimated Annualized Revenue],\n    KEEPFILTERS ( 'Partner Deal'[IsDealWith#PartnerGTM] = 1 ),\n    KEEPFILTERS (\n        FILTER(\n            'Partner Deal',\n            'Partner Deal'[Referral Microsoft SubStatus(PartnerCenter)] = \"Accepted\"\n                || 'Partner Deal'[Partner Acceptance SubStatus(PartnerCenter)] = \"Accepted\"\n        )\n    ),\n    KEEPFILTERS (\n        FILTER(\n            'Opportunity',\n            'Opportunity'[MSX Sales Stage] = \"1-Listen & Consult\"\n        )\n    )\n)\n",
            "lineageTag": "44e99375-8574-4c13-ad81-9e7df81795f9",
            "changedProperties": [
              {
                "property": "Name"
              }
            ],
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "$ Shared Opportunities Stage 2+",
            "expression": "\nCALCULATE(\n    [Billed Opportunity Revenue] + [Milestone Estimated Annualized Revenue],\n    KEEPFILTERS ( 'Partner Deal'[IsDealWith#PartnerGTM] = 1 ),\n    KEEPFILTERS (\n        FILTER(\n            'Partner Deal',\n            'Partner Deal'[Referral Microsoft SubStatus(PartnerCenter)] = \"Accepted\"\n                || 'Partner Deal'[Partner Acceptance SubStatus(PartnerCenter)] = \"Accepted\"\n        )\n    ),\n    KEEPFILTERS (\n        FILTER(\n            'Opportunity',\n            'Opportunity'[MSX Sales Stage] IN {\n                \"2-Inspire & Design\",\n                \"3-Empower & Achieve\",\n                \"4-Realize Value\",\n                \"5-Manage & Optimize\"\n}\n        )\n    )\n)\n",
            "lineageTag": "f221da3f-572d-4ad2-b28d-828751f2980a",
            "changedProperties": [
              {
                "property": "Name"
              }
            ],
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Oppty ROI old",
            "expression": "DIVIDE([$ Shared Opportunities], [Investment Approved Amount])",
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "e2540825-7eca-4b57-9d56-8643bb907723",
            "changedProperties": [
              {
                "property": "Name"
              },
              {
                "property": "FormatString"
              }
            ]
          },
          {
            "name": "Co-sell Opportunities # (PartnerGTM)",
            "expression": "CALCULATE (\n    SUMX (\n        SUMMARIZE (\n            'Opportunity',\n            'Opportunity'[Opportunity Number],\n            \"Value\", 1\n        ),\n        [Value]\n    ),\n    KEEPFILTERS ( 'Partner Deal'[IsDealWith#PartnerGTM] = 1 ),\n    KEEPFILTERS ( 'Partner Deal'[Partner Deal Direction] = \"Inbound\" ),\n    KEEPFILTERS ( 'Partner Deal'[Referral SubType] = \"Active Co-sell - PC\" ),\n    FILTER (\n        'Partner Deal',\n        'Partner Deal'[Referral Microsoft SubStatus(PartnerCenter)] = \"Accepted\"\n            || 'Partner Deal'[Partner Acceptance SubStatus(PartnerCenter)] = \"Accepted\"\n    )\n)",
            "lineageTag": "36e56c97-de04-40a6-9585-b0d5458c9b06"
          },
          {
            "name": "Co-sell Opportunities $ (PartnerGTM)",
            "expression": "CALCULATE(\n    [Billed Opportunity Revenue] + [Milestone Estimated Annualized Revenue],\n    KEEPFILTERS ( 'Partner Deal'[IsDealWith#PartnerGTM] = 1 ),\n    KEEPFILTERS ( 'Partner Deal'[Partner Deal Direction] = \"Inbound\" ),\n    KEEPFILTERS ( 'Partner Deal'[Referral SubType] = \"Active Co-sell - PC\" ),\n    KEEPFILTERS (\n        FILTER(\n            'Partner Deal',\n            'Partner Deal'[Referral Microsoft SubStatus(PartnerCenter)] = \"Accepted\"\n                || 'Partner Deal'[Partner Acceptance SubStatus(PartnerCenter)] = \"Accepted\"\n        )\n    )\n)",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "lineageTag": "8aae999e-2793-4976-aad9-1108d134033b",
            "changedProperties": [
              {
                "property": "FormatString"
              }
            ]
          },
          {
            "name": "Co-sell Opportunities win # (PartnerGTM)",
            "expression": "CALCULATE (\n    SUMX (\n        SUMMARIZE (\n            'Opportunity',\n            'Opportunity'[Opportunity Number],\n            \"Value\", 1\n        ),\n        [Value]\n    ),\n    KEEPFILTERS ( 'Partner Deal'[IsDealWith#PartnerGTM] = 1 ),\n    KEEPFILTERS ( 'Partner Deal'[Partner Deal Direction] = \"Inbound\" ),\n    KEEPFILTERS ( 'Partner Deal'[Referral SubType] = \"Active Co-sell - PC\" ),\n    FILTER (\n        'Partner Deal',\n        'Partner Deal'[Referral Microsoft SubStatus(PartnerCenter)] = \"Accepted\"\n            || 'Partner Deal'[Partner Acceptance SubStatus(PartnerCenter)] = \"Accepted\"\n            || 'Partner Deal'[Partner Acceptance SubStatus(PartnerCenter)] = \"Won\"\n    ),\n    FILTER (\n        'Opportunity',\n        'Opportunity'[Billed Revenue Status] = \"Won\"\n            || (\n                'Opportunity'[Consumption Status] = \"Closed\"\n                && 'Opportunity'[Consumption Status Reason] = \"Completed\"\n            )\n    )\n)",
            "lineageTag": "041304eb-aa74-4a6b-8837-217573a460e2"
          },
          {
            "name": "Co-sell Opportunities win $ (PartnerGTM)",
            "expression": "/*CALCULATE(\n    [Billed Opportunity Revenue] + [Milestone Estimated Annualized Revenue],\n    KEEPFILTERS ( 'Partner Deal'[IsDealWith#PartnerGTM] = 1 ),\n    KEEPFILTERS ( 'Partner Deal'[Partner Deal Direction] = \"Inbound\" ),\n    KEEPFILTERS ( 'Partner Deal'[Referral SubType] = \"Active Co-sell - PC\" ),\n    //KEEPFILTERS ( 'Opportunity'[Billed Revenue Status] = \"Won\" ),\n    /*KEEPFILTERS (\n        FILTER(\n            'Partner Deal',\n            'Partner Deal'[Referral Microsoft SubStatus(PartnerCenter)] = \"Accepted\"\n                || 'Partner Deal'[Partner Acceptance SubStatus(PartnerCenter)] = \"Accepted\"\n        )\n    ),*/\n    FILTER (\n        'Opportunity',\n        'Opportunity'[Billed Revenue Status] = \"Won\"\n            || (\n                'Opportunity'[Consumption Status] = \"Closed\"\n                && 'Opportunity'[Consumption Status Reason] = \"Completed\"\n            )\n    )\n)*/\n\nCALCULATE([$ Shared Opportunities dup],\n            // REMOVEFILTERS('Partner Deal'[Referral SubType]),\n          FILTER('Opportunity','Opportunity'[Billed Revenue Status] = \"Won\" \n             || ('Opportunity'[Consumption Status] = \"Closed\" && 'Opportunity'[Consumption Status Reason] = \"Completed\")\n    ),\n    \n    KEEPFILTERS ( 'Partner Deal'[Partner Deal Direction] = \"Inbound\" ),\n    KEEPFILTERS ( 'Partner Deal'[Referral SubType] = \"Active Co-sell - PC\" )\n)",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "lineageTag": "61f61896-6eb8-4565-b397-d61eec0479f5",
            "changedProperties": [
              {
                "property": "FormatString"
              }
            ]
          },
          {
            "name": "Win ROI",
            "expression": "DIVIDE([Co-sell Opportunities win $ (PartnerGTM)], [Investment Approved Amount])",
            "formatString": "0%;-0%;0%",
            "lineageTag": "3ea89bc9-0ba7-4e04-b48f-45fa6b974ccf",
            "changedProperties": [
              {
                "property": "FormatString"
              }
            ]
          }
        ],
