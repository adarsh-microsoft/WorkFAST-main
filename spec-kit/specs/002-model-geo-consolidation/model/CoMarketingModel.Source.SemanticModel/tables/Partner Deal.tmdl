table 'Partner Deal'
	lineageTag: b241a877-d49e-4bec-b1a5-ccdbfcff86aa
	sourceLineageTag: [CoSell].[DimPartnerDealCD]

	measure '# Partner Deals' =
			CALCULATE (
			        SUMX (
			            SUMMARIZE (
			                'Partner Deal',
			                'Partner Deal'[PartnerDealKey],
			                "Value",1
			            ),
			            [Value]
			        ),
			        REMOVEFILTERS('Partner Deal'[IsDealWith#PartnerGTM])
			    )
		formatString: #,0
		lineageTag: 9adac328-a1b2-4feb-b25d-c357180cbb72

		changedProperty = FormatString

		changedProperty = IsHidden

	measure 'Partners using #PartnerGTM' =
			CALCULATE (
			        SUMX (
			            SUMMARIZE (
			                'Reporting PartnerOne',
			                'Reporting PartnerOne'[PartnerOne ID],
			                "value",1
			            ),
			            [value]
			        ),KEEPFILTERS('Partner Deal'[IsDealWith#PartnerGTM] = 1)
			    )
		formatString: 0
		lineageTag: 96fda8d2-a1f8-4288-8102-890d27a55e76

	measure '# Total Wins' = ```
			
			CALCULATE(
			    [# Partner Deals], 
			    REMOVEFILTERS('Partner Deal'[IsDealWith#PartnerGTM]),
			    KEEPFILTERS('Partner Deal'[Partner Acceptance SubStatus(PartnerCenter)] = "Won"),
			    KEEPFILTERS(('Opportunity'[Consumption Status Reason] = "Completed" && 
			                'Opportunity'[Consumption Status] = "Closed") || 
			                'Opportunity'[Billed Revenue Status] = "Won"
			    )
			)
			```
		formatString: 0
		lineageTag: f72f862f-ff93-4047-9e15-ed463bb00b54

	measure 'Partner Deal Revenue' =
			SUMX (
			    SUMMARIZE (
			        'Fact Partner Deal',
			        'Fact Partner Deal'[PartnerDealKey],
			        'Fact Partner Deal'[PartnerRevenueCD]
			    ),
			    [PartnerRevenueCD]
			)
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 680f3ee0-f91d-4d2f-8702-140adeef98a1

		annotation PBI_FormatHint = {"isDecimal":true}

	measure '# Inbound Referrals' = ```
			CALCULATE ( 
			    [# Partner Deals], 
			    KEEPFILTERS ( 'Partner Deal'[Partner Deal Direction] = "Inbound" ),
			    REMOVEFILTERS ( 'Partner Deal'[IsDealWith#PartnerGTM] )
			)
			```
		formatString: #,0
		lineageTag: 61cd1aae-5ae9-44ab-ab64-c37dbe631f2a

	measure '# Outbound Referrals ' = ```
			
			CALCULATE ( 
			
			        [# Partner Deals], 
			        KEEPFILTERS('Partner Deal'[Partner Deal Direction] = "Outbound") 
			
			    ) 
			```
		formatString: 0
		lineageTag: 24cc3419-0cea-43b2-83af-4b9f0f47f6d9

	measure '# Partner Deals PartnerGTM' =
			CALCULATE (
			        SUMX (
			            SUMMARIZE (
			                'Partner Deal',
			                'Partner Deal'[PartnerDealKey],
			                "Value",1
			            ),
			            [Value]
			        )
			    )
		formatString: #,0
		lineageTag: 5fcfc23e-a97c-40b7-8da0-7b8275e027ae

	measure 'Partner Reported # Wins' = ```
			
			CALCULATE ( 
			        [# Partner Deals], 
			        // ALL('Partner Deal'[IsDealWith#PartnerGTM]),
			        KEEPFILTERS('Partner Deal'[Partner Acceptance SubStatus(PartnerCenter)] = "Won")
			    )
			```
		formatString: 0
		lineageTag: e948d1a9-3ed7-4343-85f9-2c34c04b02fa

	measure 'Partner Reported $ Wins' = ```
			
			CALCULATE ( 
			        [Partner Deal Revenue], 
			        KEEPFILTERS('Partner Deal'[Partner Acceptance SubStatus(PartnerCenter)] = "Won")
			    )
			```
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: fae87646-e397-45f6-9edc-c59d14fcc950

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure '# Inbound PartnerGTM Referrals' = ```
			
			CALCULATE ( 
			
			        'Partner Deal'[# Partner Deals PartnerGTM], 
			        KEEPFILTERS('Partner Deal'[Partner Deal Direction] = "Inbound") ,
			        KEEPFILTERS( 'Partner Deal'[IsDealWith#PartnerGTM] =1)
			    ) 
			```
		formatString: #,0
		lineageTag: 71330a83-d81e-4643-96b0-35b6fdef18e6

	measure 'Marketing Contribution to Referrals %' = DIVIDE( [# Inbound PartnerGTM Referrals], [# Inbound Referrals old],0)
		formatString: 0%;-0%;0%
		lineageTag: 1135b794-ce2a-47d3-82b7-fba0ca7ccbcc

	measure '% Partners using #PartnerGTM' = ```
			
			DIVIDE(
			    [Partners using #PartnerGTM], 
			    [# Partner Investment], 
			    0
			)
			```
		formatString: 0%;-0%;0%
		lineageTag: 29934e5c-c247-4fe3-828c-7d5c247c5028

	measure 'Partner Deal Revenue (Aligned)' =
			
			CALCULATE(
			    [Partner Deal Revenue],
			    TREATAS(
			        VALUES(InvCustomPartnerReportingGeography[BigArea]),
			        CustomPartnerReportingGeography[BigArea]
			    )
			)
		formatString: 0
		lineageTag: d9acb7b8-9c57-4bca-88c8-31d53e4c8e11

		changedProperty = Name

	measure '# Partner Deals PartnerGTM (Aligned)' =
			
