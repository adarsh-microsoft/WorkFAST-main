	measure '#% Inbound Active Co-sell' = ```
			DIVIDE (
			    [Inbound Active-Co-sell Referral # w/PartnerGTM],   
			    [# Inbound Active-Co-sell Referral],   -
			    0                    -- fallback when denominator is 0 or BLANK
			)
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 5725511c-bc33-4b8e-87df-71800705255f

