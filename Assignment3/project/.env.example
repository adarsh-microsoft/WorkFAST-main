# ──────────────────────────────────────────────────────────────────────────────
# Grounded Policy Q&A — Environment Configuration
# Copy this file to `.env` and fill in your values. NEVER commit `.env`.
# Authentication is via environment variables ONLY. No secrets in source code.
# ──────────────────────────────────────────────────────────────────────────────

# ── Azure OpenAI ──────────────────────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://oaiagenticaitraining-track2.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-azure-openai-api-key>
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Chat completion deployment (answer generation)
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini

# Embedding deployment (vectorization)
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
# text-embedding-3-large native dimension is 3072
AZURE_OPENAI_EMBEDDING_DIMENSIONS=3072

# ── Azure AI Search ───────────────────────────────────────────────────────────
AZURE_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
AZURE_SEARCH_API_KEY=<your-search-admin-api-key>
AZURE_SEARCH_INDEX_NAME=hr-policy-index
AZURE_SEARCH_SEMANTIC_CONFIG=hr-policy-semantic

# ── Retrieval tuning ──────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=5
